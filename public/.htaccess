# Ionic — Apache config for Hetzner hosting
# Copied verbatim into dist/ by `astro build`.

RewriteEngine On

# Force HTTPS and the canonical www host in a single hop.
#
# The previous version chained two 301s: http://ionicinnovate.com/x first
# became https://ionicinnovate.com/x, and only on the next request became
# https://www.ionicinnovate.com/x. Collapsing the apex case into one rule
# removes a redirect from every cold visit.
RewriteCond %{HTTP_HOST} ^ionicinnovate\.com$ [NC]
RewriteRule ^(.*)$ https://www.ionicinnovate.com/$1 [R=301,L]

RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Astro emits directory-style URLs (/contact/index.html served at /contact/).
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Fonts and hashed assets are immutable — Astro fingerprints the filenames.
    <FilesMatch "\.(woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\-[A-Za-z0-9_]{8}\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Block direct access to non-web files
<FilesMatch "\.(docx|md|log|json|lock)$">
    Require all denied
</FilesMatch>

# ...but the feed and manifest-style files must stay reachable.
<FilesMatch "^(sitemap.*\.xml|rss\.xml|robots\.txt)$">
    Require all granted
</FilesMatch>
