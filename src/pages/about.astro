---
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { Image } from 'astro:assets';
import SectionHead from '@/components/SectionHead.astro';
import ContactSection from '@/components/ContactSection.astro';
import { site, leadership, offices, compliance } from '@/data/site';

/**
 * About.
 *
 * The site ran without a single named person on it, which for a consultancy
 * is a strange thing to leave out: the people are what is being bought. This
 * is also the page a buyer opens second, after the homepage.
 *
 * Photographs are still outstanding, so each portrait falls back to initials
 * rather than rendering an empty frame or a stock face.
 */

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: `About ${site.legalName}`,
    url: new URL('/about/', site.domain).href,
    mainEntity: { '@id': `${site.domain}/#org` },
  },
  ...leadership.map((p) => ({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: p.name,
    jobTitle: p.role,
    worksFor: { '@type': 'Organization', name: site.legalName, url: site.domain },
    ...(p.linkedin ? { sameAs: [p.linkedin] } : {}),
  })),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.domain + '/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: new URL('/about/', site.domain).href },
    ],
  },
];

/** What we hold to. Stated as commitments, each one falsifiable. */
const principles = [
  {
    name: 'Technology-agnostic',
    detail:
      'We have no reseller targets. We recommend what fits, including tools we did not build and fixes that need no software at all.',
  },
  {
    name: 'Business-owned',
    detail:
      'The people who do the work shape the change. Transformation the business owns is the kind that survives once we leave.',
  },
  {
    name: 'Understand before building',
    detail:
      'We map how work actually happens before configuring anything. Automating a misunderstood process only produces wrong answers faster.',
  },
  {
    name: 'Open to every size',
    detail: 'The same thinking is available to a ten-person business and a listed group, priced for each.',
  },
  {
    name: 'Teach as we go',
    detail:
      'Every engagement leaves people with process skills they keep. Process Genesis is built to teach while it works.',
  },
  {
    name: 'Say what we do not know',
    detail:
      'If a number is an estimate, we label it. If something is not a fit for us, we say so and point you elsewhere.',
  },
];
const founder = leadership.find((x) => 'founderNote' in x);
---

<PageLayout
  title={`About ${site.legalName}: who we are and how we work | ${site.name}`}
  description="Ionic Innovate was founded by Reneil Harilall to make technology-agnostic, business-owned transformation affordable at every size, with delivery led from Alberta and South Africa."
  schema={schema}
>
  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <div class="shell relative pb-20 pt-14 md:pb-28">
      <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'About' }]} />

      <p class="marker mt-12" style="animation:rise 0.9s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:60ms">
        Who we are
      </p>

      <h1
        class="mt-6 max-w-4xl font-display"
        style="font-size:clamp(2rem,4.4vw,3.5rem);line-height:1.06;animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:150ms"
      >
        We built the consultancy we wanted to hire.
      </h1>

      <div class="rule mt-9 w-28" style="animation-delay:300ms"></div>

      <p class="t-lede measure mt-9 text-fg-3" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:360ms">
        Every business is different. Transformation should respect what makes yours work, and it
        should not only be affordable for the largest companies.
      </p>
    </div>
  </section>

  <!-- ══ FOUNDER’S NOTE ═══════════════════════════════════════════════ -->
  {/* In his own words and signed, so it reads as a note from him rather
      than copy written about him. He is filtered out of the leadership
      list below for the same reason: a founder's note and a team card are
      not the same thing. */}
  {
    founder && (
      <section class="band-alt seam">
        <div class="shell py-32 md:py-44">
          <SectionHead marker="Founder’s note" title="Why we" titleAccent="exist." />

          <div class="mt-16 grid gap-10 lg:grid-cols-[0.32fr_1fr] lg:gap-16">
            <div class="lg:sticky lg:top-28 lg:self-start">
              {/* Shown at the size the file actually is. The source is 100px
                  square; in a 13rem portrait frame it was being enlarged two
                  and a half times and every softness in it was on display.
                  At 1:1 it is sharp, and the frame does the work the size
                  used to: a rule above it, a hairline border, and the name
                  set against it rather than under a large picture. */}
              {'photo' in founder && founder.photo && (
                <div class="flex items-center gap-5">
                  <div class="shrink-0 border border-line bg-raised p-1">
                    <Image
                      src={founder.photo}
                      alt={`${founder.name}, ${founder.role} of ${site.name}`}
                      widths={[100, 200]}
                      sizes="6.25rem"
                      quality={100}
                      format="webp"
                      class="block h-[6.25rem] w-[6.25rem] object-cover"
                    />
                  </div>
                  <span class="rule hidden h-px flex-1 lg:block"></span>
                </div>
              )}
              <p class="mt-6 font-display text-[1.375rem] leading-snug text-fg">{founder.name}</p>
              <p class="mt-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-primary">
                {founder.role} · {founder.base}
              </p>
            </div>

            <div>
              <div class="prose-tech">
                {founder.founderNote.map((para) => (
                  <p>{para}</p>
                ))}
              </div>
              <p class="mt-10 font-display text-[1.0625rem] leading-snug text-fg">{founder.name}</p>
              <p class="mt-1 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-4">
                {founder.role}
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ══ LEADERSHIP ════════════════════════════════════════════════════ -->
  <section id="leadership" class="border-t border-line scroll-mt-20">
    <div class="shell py-32 md:py-44">
      <SectionHead
        marker="Leadership"
        title="The people who"
        titleAccent="do the work."
        lede="You speak to senior people who have delivered this kind of work before, not to an account manager who hands you on."
      />

      <div class="mt-20 space-y-20">
        {
          leadership.filter((x) => !('founderNote' in x)).map((p, i) => (
            <article class="rise grid gap-10 lg:grid-cols-[0.32fr_1fr] lg:gap-16" style={`--step:${i}`}>
              <div class="lg:sticky lg:top-28 lg:self-start">
                {/* The photograph where there is one. Where there is not,
                    initials: an empty frame reads as a broken image and a
                    stock face would be a lie, so the placeholder gets a
                    treatment of its own, corner ticks and a slow pass across
                    it. It should look reserved, not unfinished. */}
                {'photo' in p && p.photo ? (
                  <div class="relative aspect-[4/5] w-full max-w-[13rem] overflow-hidden border border-line bg-raised">
                    <Image
                      src={p.photo}
                      alt={`${p.name}, ${p.role}`}
                      widths={[208, 416]}
                      sizes="13rem"
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  </div>
                ) : (
                  <div class="portrait relative aspect-[4/5] w-full max-w-[13rem] overflow-hidden border border-line bg-raised" aria-hidden="true">
                    <span class="portrait-grid"></span>
                    <span class="portrait-scan"></span>
                    <span class="portrait-tick" data-c="tl"></span>
                    <span class="portrait-tick" data-c="tr"></span>
                    <span class="portrait-tick" data-c="bl"></span>
                    <span class="portrait-tick" data-c="br"></span>
                    <span class="absolute inset-0 flex items-center justify-center">
                      <span class="figure text-[2.5rem] text-fg-4">{p.initials}</span>
                    </span>
                  </div>
                )}

                <h2 class="mt-6 font-display text-[1.375rem] leading-snug text-fg">{p.name}</h2>
                <p class="mt-2 font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-primary">{p.role}</p>
                <p class="mt-1.5 text-sm text-fg-4">{p.base}</p>

                {p.linkedin && (
                  <a class="link-u mt-4 inline-block text-sm" href={p.linkedin} rel="noopener">
                    LinkedIn ↗
                  </a>
                )}
              </div>

              <div>
                <p class="t-lede measure text-fg-2">{p.lede}</p>
                <div class="prose-tech mt-8">
                  {p.bio.map((para) => (
                    <p>{para}</p>
                  ))}
                  {'qualification' in p && p.qualification && (
                    <p class="text-sm text-fg-4">{p.qualification}</p>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ PRINCIPLES ════════════════════════════════════════════════════ -->
  <section class="border-t border-line">
    <div class="shell py-32 md:py-44">
      <SectionHead marker="What we hold to" title="How we work with clients" />

      <div class="mt-20 grid gap-px overflow-hidden border border-line bg-line-strong sm:grid-cols-2 lg:grid-cols-3">
        {
          principles.map((pr, i) => (
            <article class="rise group relative bg-base p-8 transition-colors duration-500 hover:bg-raised md:p-10" style={`--step:${i}`}>
              <span class="figure text-xs text-primary">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-5 font-display text-xl leading-snug text-fg">{pr.name}</h3>
              <p class="mt-3.5 text-sm leading-relaxed text-fg-3">{pr.detail}</p>
              <span class="absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-primary transition-transform duration-700 ease-out group-hover:scale-x-100" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ WHERE WE WORK ═════════════════════════════════════════════════ -->
  <section class="band-alt seam">
    <div class="shell py-32 md:py-44">
      <SectionHead
        marker="Where we work"
        title="Two home markets,"
        titleAccent="clients anywhere."
      />

      <div class="mt-20 grid gap-px overflow-hidden border border-line bg-line-strong md:grid-cols-2">
        {
          offices.map((o, i) => (
            <a href={`/${o.code.toLowerCase()}/`} class="rise group bg-base p-8 transition-colors duration-500 hover:bg-raised md:p-10" style={`--step:${i}`}>
              <p class="mono-label">{o.region}</p>
              <h3 class="mt-4 font-display text-2xl text-fg">{o.heading}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-fg-3">{o.detail}</p>

              <ul class="mt-6 flex flex-wrap gap-2">
                {o.cities.map((c) => (
                  <li class="chip !py-1 !text-[0.6875rem]">{c}</li>
                ))}
              </ul>

              <span class="link-u mt-7 inline-block text-sm">Ionic in {o.region} →</span>
            </a>
          ))
        }
      </div>

      <p class="mt-10 font-mono text-[0.6875rem] leading-relaxed text-fg-4">
        We work within {compliance.map((c) => `${c.law} in ${c.region}`).join(' and ')}, and agree hosting
        and data residency with you before anything is loaded.
      </p>
    </div>
  </section>

  <!-- ══ COMMUNITY ═════════════════════════════════════════════════════ -->
  <section class="border-t border-line">
    <div class="shell py-32 md:py-44">
      <div class="grid gap-14 lg:grid-cols-[1fr_0.42fr] lg:gap-20">
        <div>
          <SectionHead marker="Community" title="Making digital skills accessible" />
          <div class="prose-tech rise mt-10">
            <p>
              Transformation should not be limited to companies with large budgets, and digital
              careers should not be limited to people who already have a way in.
            </p>
            <p>
              We support women in technology, youth development and programmes in underprivileged
              communities, in both South Africa and Canada. The aim is straightforward: help more
              people gain the skills to take part in the digital economy, and give smaller
              organisations access to tools usually priced for the few.
            </p>
          </div>
        </div>

        <aside class="rise lg:pt-20" style="--step:1">
          <div class="surface p-8">
            <p class="mono-label">Programmes</p>
            <ul class="mt-5 space-y-3 text-[0.9375rem] text-fg-2">
              <li class="border-b border-line pb-3">Women in tech mentorship</li>
              <li class="border-b border-line pb-3">Youth digital skills</li>
              <li>Community outreach</li>
            </ul>
            <p class="mt-5 font-mono text-[0.625rem] leading-relaxed text-fg-4">
              Named partners and programmes to follow.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <ContactSection
    source="About page"
    returnPath="/about/"
    title="Talk to the people who will do the work"
    lede="Thirty minutes with someone who has done this at enterprise scale. You leave with a clearer view of where to start, whether or not we work together."
  />
</PageLayout>

<style>
  /* Faint measured grid, so the frame reads as a reserved slot. */
  .portrait-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 25% 20%;
    opacity: 0.45;
  }

  /* One slow pass, long gap between. Anything faster reads as a loading bar. */
  .portrait-scan {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 28%;
    background: linear-gradient(to bottom, transparent, color-mix(in oklch, var(--primary) 14%, transparent), transparent);
    animation: portrait-pass 9s ease-in-out infinite;
  }
  @keyframes portrait-pass {
    0%, 8% { transform: translateY(-100%); }
    42%, 100% { transform: translateY(360%); }
  }

  .portrait-tick {
    position: absolute;
    width: 0.75rem;
    height: 0.75rem;
    border: 1px solid var(--accent-warm);
    opacity: 0.55;
    transition: opacity 0.4s;
  }
  .portrait-tick[data-c='tl'] { top: 0.5rem; left: 0.5rem; border-right: 0; border-bottom: 0; }
  .portrait-tick[data-c='tr'] { top: 0.5rem; right: 0.5rem; border-left: 0; border-bottom: 0; }
  .portrait-tick[data-c='bl'] { bottom: 0.5rem; left: 0.5rem; border-right: 0; border-top: 0; }
  .portrait-tick[data-c='br'] { bottom: 0.5rem; right: 0.5rem; border-left: 0; border-top: 0; }
  .portrait:hover .portrait-tick { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .portrait-scan { animation: none; opacity: 0; }
  }
</style>
