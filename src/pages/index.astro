---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import BootSequence from '@/components/BootSequence.astro';
import HeroVisual from '@/components/HeroVisual.astro';
import WhatWeDo from '@/components/WhatWeDo.astro';
import Figure from '@/components/Figure.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProductCard from '@/components/ProductCard.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import ImpactSection from '@/components/ImpactSection.astro';
import ProjectsSection from '@/components/ProjectsSection.astro';
import ContactSection from '@/components/ContactSection.astro';
import { site, contact, expertise } from '@/data/site';
import { projectStats } from '@/data/projects';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const flagship = products.find((p) => p.data.flagship);
const rest = products.filter((p) => !p.data.flagship);

const studies = (await getCollection('caseStudies'))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  alternateName: site.legalName,
  url: site.domain,
  email: contact.email,
  description: site.description,
  slogan: site.slogan,
  areaServed: ['South Africa', 'Canada', 'Australia'],
  knowsAbout: [...expertise],
  makesOffer: products.map((p) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: p.data.name, description: p.data.summary },
  })),
};

const principles = [
  {
    n: '01',
    head: 'Discovery before software',
    body: 'We map how work actually moves, not how the documentation says it does. Automating a process you have misunderstood produces a faster wrong answer.',
  },
  {
    n: '02',
    head: 'Consulting and product, together',
    body: 'Strategy, change management and our own SaaS portfolio in one engagement. Consulting establishes what you need; products supply it only where they genuinely fit.',
  },
  {
    n: '03',
    head: 'Technology-agnostic, provably',
    body: 'Clients evaluate our platforms inside live consulting engagements. That puts the honest answer in front of both parties continuously.',
  },
];

const method = [
  { step: 'Discover', body: 'Process mining against reality. Bottlenecks quantified before anything is configured.' },
  { step: 'Design', body: 'Scope, outcomes and costs. We recommend what fits, not what we sell.' },
  { step: 'Deploy', body: 'Pilot first, scoped so being wrong is survivable. Expansion follows the result.' },
  { step: 'Operate', body: 'Through production and beyond. Transformation nobody adopts is not transformation.' },
];
---

<PageLayout
  title="Ionic: AI-Powered Digital & Business Transformation Consultancy"
  description="Ionic combines strategic consulting with proprietary AI-enabled SaaS platforms (Process Genesis, ExpenseFlow, Ionic ERP and Ionic GRC) to help enterprises like Old Mutual, Fidelity and Bidvest modernise operations end-to-end."
  schema={schema}
>
  <BootSequence />

  {/* ══════════ 00 · HERO ══════════
      Stripped back to a headline, one line, two buttons and the rings.
      Everything else that used to live here competed with it: four floating
      readout cards, a three-up metric strip, a provenance line, a blueprint
      grid and two washes. The numbers were never lost by removing them, they
      already appear in the ticker above and as gauges in Impact. */}
  <section class="relative overflow-hidden">
    <div class="aurora -right-40 -top-40 h-[34rem] w-[34rem]"></div>

    <div class="shell relative grid items-center gap-12 pb-24 pt-20 lg:grid-cols-[1fr_0.85fr] lg:gap-16 lg:pb-36 lg:pt-28">
      <div>
        <h1 class="t-hero">
          <span class="block overflow-hidden">
            <span class="rise block" style="--step:0">Transformation,</span>
          </span>
          {/* The slash has to sit inside the second line. The two line
              wrappers are block-level, so an inline-block sibling after them
              wrapped onto a third line at hero size. */}
          <span class="block overflow-hidden">
            <span class="rise block" style="--step:1.6">
              <span class="grad-text">instrumented.</span><span class="slash" aria-hidden="true">/</span>
            </span>
          </span>
        </h1>

        <p class="t-lede rise measure mt-8 text-fg-3" style="--step:3">
          Strategic consulting and our own AI-enabled platforms, from the first workshop
          through to production.
        </p>

        <div class="rise mt-10 flex flex-wrap items-center gap-3" style="--step:4">
          <a href="/contact/" class="btn">
            <span>Start a conversation</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="#work" class="btn-ghost">See the work</a>
        </div>
      </div>

      <div class="lift relative mx-auto w-full max-w-[460px]" style="--step:2">
        <HeroVisual />
      </div>
    </div>
  </section>


  <!-- ══════════ 01 · WHAT WE DO ══════════ -->
  {/* Pale band directly under the hero, mirroring the model site's opening
      move. The page used to run from hero straight into prose. */}
  <WhatWeDo />

  <!-- ══════════ 02 · PRINCIPLES ══════════ -->
  <section id="about" class="seam scroll-mt-16">
    <div class="shell py-32 md:py-44">
      <SectionHead n="01" marker="Approach" title="We become an extension of" titleAccent="your business." />

      <div class="mt-20 grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-10">
        <Figure
          photo="deliveryTeam"
          class="lift"
          sizes="(min-width: 1024px) 38rem, 100vw"
          ratio="4 / 3"
          float
        />

        <div class="grid gap-3 sm:grid-cols-2 lg:content-start">
          {
            principles.map((p, i) => (
              <article class="surface card-i rise p-6" style={`--step:${i}`}>
                <span class="figure text-[0.6875rem] text-primary">{p.n}</span>
                <h3 class="mt-5 text-[1.0625rem] font-medium tracking-[-0.02em]">{p.head}</h3>
                <p class="mt-3 text-[0.875rem] leading-relaxed text-fg-3">{p.body}</p>
              </article>
            ))
          }

          <article class="surface rise flex flex-col justify-center bg-panel p-6" style="--step:3">
            <p class="mono-label">Expertise</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {expertise.map((e) => <li class="chip">{e}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 02 · PLATFORMS ══════════ -->
  {/* First inverted band. The reference alternates pale and dark sections,
      and that rhythm is most of what makes it feel spacious; a single ground
      down the whole page cannot produce it. */}
  <section id="platforms" class="band-alt seam scroll-mt-16">
    <div class="shell py-32 md:py-44">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHead
          n="02"
          marker="Platforms"
          title="Four proprietary products,"
          titleAccent="built for enterprise."
          lede="Each solves a problem we kept meeting in consulting engagements. Each is deployed."
        />
        <a href="/case-studies/" class="link-u rise font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-fg-3" style="--step:3">
          See them in the field →
        </a>
      </div>

      {/* Two up, not four. Four products across a 4-column grid with the
          flagship spanning two left a single orphan on the second row, and
          the cards were too narrow for the image to carry anything. */}
      <div class="mt-20 grid gap-5 md:grid-cols-2">
        {flagship && <ProductCard product={flagship} index={0} />}
        {rest.map((p, i) => <ProductCard product={p} index={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- ══════════ 03 · IMPACT ══════════ -->
  <ImpactSection />

  <!-- ══════════ 04 · WORK ══════════ -->
  <ProjectsSection />

  {/* Method stays on the page ground: the model site's process row is one of
      its dark sections, and two pale bands in a row loses the alternation. */}
  <!-- ══════════ 05 · METHOD ══════════ -->
  <section class="seam">
    <div class="shell py-32 md:py-44">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHead n="05" marker="Method" title="Four steps," titleAccent="in this order." />
        <div class="rise w-full max-w-md lg:max-w-lg" style="--step:2">
          <Figure photo="programmeDelivery" sizes="(min-width: 1024px) 32rem, 100vw" ratio="21 / 9" float />
        </div>
      </div>

      {/* Steps read as a row of stations rather than four equal cards. The
          descriptions alternate above and below the line so consecutive
          blocks of text never sit shoulder to shoulder, which is what made
          the card version hard to scan. Below `md` it collapses to a plain
          list, because a horizontal track on a phone is just a squeeze. */}
      {/* Every step shares one five-row track (text · riser · circle · riser ·
          text) and the circle is always row 3, so all four circles sit on a
          single baseline while only the labels alternate. Ordering them with
          flex instead staggered the circles, which lost the through-line that
          makes the row read as a sequence. Below `md` it collapses to circle
          then text, because a horizontal track on a phone is just a squeeze. */}
      <ol
        class="mt-20 grid gap-x-4 gap-y-12 md:grid-cols-4 md:gap-y-0 md:[grid-template-rows:minmax(0,1fr)_2.5rem_auto_2.5rem_minmax(0,1fr)]"
      >
        {
          method.map((m, i) => {
            const above = i % 2 === 0;
            return (
              <li
                class="step rise grid justify-items-center gap-y-5 md:row-span-5 md:grid-rows-subgrid md:gap-y-0"
                style={`--step:${i}`}
              >
                <p
                  class:list={[
                    'order-2 max-w-[15rem] text-center text-[0.875rem] leading-relaxed text-fg-3 md:order-none',
                    above ? 'md:row-start-1 md:self-end' : 'md:row-start-5 md:self-start',
                  ]}
                >
                  {m.body}
                </p>

                {/* Riser: the chevron points at the label, the dots run to the
                    circle, so the pair always reads text-ward. */}
                <span
                  class:list={[
                    'hidden flex-col items-center md:flex',
                    above ? 'md:row-start-2 md:flex-col-reverse' : 'md:row-start-4',
                  ]}
                  aria-hidden="true"
                >
                  <span class="step-riser my-1.5 h-7 w-px"></span>
                  <svg width="26" height="14" viewBox="0 0 26 14" fill="none" class="text-primary">
                    <path
                      d={above ? 'M2 12 L13 2 L24 12' : 'M2 2 L13 12 L24 2'}
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>

                <div class="step-dot order-1 w-32 md:order-none md:row-start-3 md:w-full md:max-w-[9.5rem]">
                  <span class="figure text-[1.75rem] leading-none text-fg-2">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="mt-1 text-[0.9375rem] font-medium tracking-[-0.01em]">{m.step}</h3>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- ══════════ 06 · CASE STUDIES ══════════ -->
  <section class="seam">
    <div class="shell py-32 md:py-44">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHead n="06" marker="Engagements" title="Trusted where" titleAccent="it counts." />
        <a href="/case-studies/" class="link-u rise font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-fg-3" style="--step:3">
          All {projectStats.total} engagements →
        </a>
      </div>

      <div class="mt-20 grid gap-3 md:grid-cols-3">
        {studies.map((s, i) => <CaseStudyCard study={s} index={i} />)}
      </div>
    </div>
  </section>

  <!-- ══════════ 07 · CONTACT ══════════ -->
  <ContactSection
    source="Homepage"
    returnPath="/"
    showInvestor
    lede="Whether you have a transformation challenge or want to see how AI-enabled technology could modernise your operations, tell us about it. We reply within one business day."
  />
</PageLayout>
