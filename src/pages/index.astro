---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import BootSequence from '@/components/BootSequence.astro';
import HeroVisual from '@/components/HeroVisual.astro';
import WhatWeDo from '@/components/WhatWeDo.astro';
import Figure from '@/components/Figure.astro';
import SectionHead from '@/components/SectionHead.astro';
import ProductCard from '@/components/ProductCard.astro';
// import CaseStudyCard from '@/components/CaseStudyCard.astro';
import ImpactSection from '@/components/ImpactSection.astro';
import ProjectsSection from '@/components/ProjectsSection.astro';
import Testimonials from '@/components/Testimonials.astro';
import ContactSection from '@/components/ContactSection.astro';
import { site, contact, expertise } from '@/data/site';
import { projectStats } from '@/data/projects';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

/**
 * The platforms heading used to hardcode "Four". Counting it means the page
 * cannot end up claiming a number the collection disagrees with, and spelling
 * it keeps the headline reading as prose rather than as a statistic.
 */
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const platformWord = WORDS[products.length] ?? String(products.length);
const flagship = products.find((p) => p.data.flagship);
const rest = products.filter((p) => !p.data.flagship);

// Fed the featured case-study cards, parked with src/pages/_case-studies.
// const studies = (await getCollection('caseStudies'))
//   .filter((s) => s.data.featured)
//   .sort((a, b) => a.data.order - b.data.order)
//   .slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  alternateName: site.legalName,
  url: site.domain,
  email: contact.email,
  description: site.description,
  slogan: site.slogan,
  areaServed: ['South Africa', 'Canada', 'Australia'],
  knowsAbout: [...expertise],
  makesOffer: products.map((p) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: p.data.name, description: p.data.summary },
  })),
};

const principles = [
  {
    n: '01',
    head: 'Discovery before software',
    body: 'We map how work actually moves, not how the documentation says it does. Automating a process you have misunderstood produces a faster wrong answer.',
  },
  {
    n: '02',
    head: 'Consulting and product, together',
    body: 'Strategy, change management and our own SaaS portfolio in one engagement. Consulting establishes what you need; products supply it only where they genuinely fit.',
  },
  {
    n: '03',
    head: 'Technology-agnostic, provably',
    body: 'Clients evaluate our platforms inside live consulting engagements. That puts the honest answer in front of both parties continuously.',
  },
];

/* The four stages, in the wording Reneil uses. An earlier version of this
   list said Discover / Design / Deploy / Operate, which was a paraphrase
   nobody had signed off. */
const method = [
  {
    step: 'Understand',
    body: 'We map the work as it really runs, workarounds included. You see your as-is within days.',
  },
  {
    step: 'Design',
    body:
      'We recommend what fits your business and budget, from a better form to a full platform, each with its cost and its case.',
  },
  {
    step: 'Build',
    body: 'We deliver in small working pieces, pilot first, so a wrong turn is cheap to correct.',
  },
  {
    step: 'Run',
    body: 'We stay through adoption with training, support and embedded people where needed.',
  },
];
---

<PageLayout
  title="Ionic: AI-Powered Digital & Business Transformation Consultancy"
  description="Technology-agnostic digital and business transformation across Canada and South Africa, with the Process Genesis platform. Work delivered for Sirago in the Old Mutual Group, the Kruse Group in Alberta, a Durban depot operator and Tippa."
  schema={schema}
  hreflang
>
  <BootSequence />

  {/* ══════════ 00 · HERO ══════════
      Stripped back to a headline, one line, two buttons and the rings.
      Everything else that used to live here competed with it: four floating
      readout cards, a three-up metric strip, a provenance line, a blueprint
      grid and two washes. The numbers were never lost by removing them, they
      already appear in the ticker above and as gauges in Impact. */}
  <section class="relative overflow-hidden">
    <div class="aurora -right-40 -top-40 h-[34rem] w-[34rem]"></div>

    <div class="shell relative grid items-center gap-12 pb-24 pt-20 lg:grid-cols-[1fr_0.85fr] lg:gap-16 lg:pb-36 lg:pt-28">
      <div>
        {/* The landing screen had no warm accent at all, which is why the
            second colour was invisible on the page people see first. */}
        <p class="marker veil">
          <span>Digital and business transformation</span>
        </p>

        <h1 class="t-hero mt-6">
          <span class="block overflow-hidden">
            <span class="rise block" style="--step:0">Transformation,</span>
          </span>
          <span class="block overflow-hidden">
            <span class="rise grad-text block" style="--step:1.6">instrumented.</span>
          </span>
          {/* Third line at two-thirds scale: it carries the actual proposition
              while keeping the first two lines as the hook. */}
          <span class="block overflow-hidden">
            <span class="rise block text-[0.58em] leading-[1.15] text-fg-3" style="--step:2.4">
              Consulting, platforms and delivery in one engagement.
            </span>
          </span>
        </h1>

        <p class="t-lede rise measure mt-8 text-fg-3" style="--step:3">
          We map how the work actually moves, quantify where the time goes, then build and
          run what changes it. Strategy and our own AI-enabled platforms from the same team,
          from first workshop through to production and beyond.
        </p>

        <div class="rise mt-10 flex flex-wrap items-center gap-3" style="--step:4">
          <a href="/contact/" class="btn">
            <span>Start a conversation</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="#work" class="btn-ghost">See the work</a>
        </div>
      </div>

      <div class="lift relative mx-auto w-full max-w-[460px]" style="--step:2">
        <HeroVisual />
      </div>
    </div>
  </section>


  <!-- ══════════ 01 · WHAT WE DO ══════════ -->
  {/* Pale band directly under the hero, mirroring the model site's opening
      move. The page used to run from hero straight into prose. */}
  <WhatWeDo />

  <!-- ══════════ 02 · PRINCIPLES ══════════ -->
  <section id="about" class="seam scroll-mt-16">
    <div class="shell py-32 md:py-44">
      <SectionHead n="01" marker="Approach" title="We become an extension of" titleAccent="your business." />

      <div class="mt-20 grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-10">
        <Figure
          photo="deliveryTeam"
          class="lift"
          sizes="(min-width: 1024px) 38rem, 100vw"
          ratio="4 / 3"
          float
        />

        <div class="grid gap-5 sm:grid-cols-2 lg:content-start">
          {
            principles.map((p, i) => (
              <article class="surface card-i rise p-7 md:p-8" style={`--step:${i}`}>
                <span class="figure text-[0.6875rem]" style="color: var(--accent-warm)">{p.n}</span>
                <h3 class="mt-5 text-[1.0625rem] font-medium tracking-[-0.02em]">{p.head}</h3>
                <p class="mt-3 text-[0.875rem] leading-relaxed text-fg-3">{p.body}</p>
              </article>
            ))
          }

          <article class="surface rise flex flex-col justify-center bg-panel p-7 md:p-8" style="--step:3">
            <p class="mono-label">Expertise</p>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {expertise.map((e) => <li class="chip">{e}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 02 · PLATFORMS ══════════ -->
  {/* First inverted band. The reference alternates pale and dark sections,
      and that rhythm is most of what makes it feel spacious; a single ground
      down the whole page cannot produce it. */}
  <section id="platforms" class="band-alt seam scroll-mt-16">
    <div class="shell py-24 md:py-32">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHead
          n="02"
          marker="Platforms"
          title={`${platformWord} platforms,`}
          titleAccent="built and running."
          lede="Each solves a problem we kept meeting in consulting engagements. Each is deployed."
        />
        {/* See them in the field, to /case-studies/, parked with that route. */}
        {/*
        <a href="/case-studies/" class="link-u rise font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-fg-3" style="--step:3">
          See them in the field →
        </a>
        */}
      </div>

      {/* Three up. Two up gave each card most of the page width, which made
          the picture the card and the words a footnote however short the
          crop. Five products across three columns leaves a gap on the second
          row, which is quieter than five oversized tiles. */}
      <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {flagship && <ProductCard product={flagship} index={0} />}
        {rest.map((p, i) => <ProductCard product={p} index={i + 1} />)}
      </div>
    </div>
  </section>

  <!-- ══════════ 03 · IMPACT ══════════ -->
  <ImpactSection />

  <!-- ══════════ 04 · WORK ══════════ -->
  <ProjectsSection />

  <!-- ══════════ 05 · HOW WE WORK ══════════ -->
  {/* Method stays on the page ground: the model site's process row is one of
      its dark sections, and two pale bands in a row loses the alternation. */}
  <section class="border-t border-line">
    <div class="shell py-32 md:py-44">
      <SectionHead n="05" marker="How we work" title="Four stages," titleAccent="always in this order." />

      <ol class="mt-20 grid gap-px overflow-hidden border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
        {method.map((m, i) => (
          <li class="rise bg-base p-8 md:p-9" style={`--step:${i}`}>
            <span class="figure text-xs text-primary">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-5 font-display text-xl leading-snug text-fg">{m.step}</h3>
            <p class="mt-3.5 text-[0.9375rem] leading-relaxed text-fg-3">{m.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>


  {/* Testimonials sit after the case-study tiles and before the contact ask,
      which is the point at which a reader has seen the work and is deciding
      whether to believe it. It is a pale band, so it also breaks up the run
      of dark sections from Impact onwards. */}
  <!-- ══════════ 07 · TESTIMONIALS ══════════ -->
  <Testimonials />

  <!-- ══════════ 08 · CONTACT ══════════ -->
  <ContactSection
    source="Homepage"
    returnPath="/"
    showInvestor
    lede="Whether you have a transformation challenge or want to see how AI-enabled technology could modernise your operations, tell us about it. We reply within one business day."
  />
</PageLayout>
