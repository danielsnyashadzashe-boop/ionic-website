---
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHead from '@/components/SectionHead.astro';
import Compass from '@/components/Compass.astro';
import { site } from '@/data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Process Compass',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  url: new URL('/compass/', site.domain).href,
  publisher: { '@type': 'Organization', name: site.name },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Five questions about one of your processes, answered by moving instruments rather than filling in a form, and one recommendation for what to do first.',
};
---

<PageLayout
  title="Process Compass: where should your process go next? | Ionic"
  description="Five questions about one of your processes, answered on a dial, a tank and a tempo rather than a form. You get one recommendation for what to fix first, and the reasoning behind it."
  schema={schema}
>
  <section class="seam scroll-mt-16">
    <div class="shell py-20 md:py-28">
      <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Process Compass' }]} />

      <SectionHead
        class="mt-8"
        marker="Tool"
        title="Five questions,"
        titleAccent="one recommendation."
        lede="Nothing is sent anywhere and nothing is stored. It runs entirely in your browser, so you can answer honestly."
      />
    </div>
  </section>

  <section class="band-alt seam">
    <div class="shell py-20 md:py-28">
      <Compass />
    </div>
  </section>
</PageLayout>
