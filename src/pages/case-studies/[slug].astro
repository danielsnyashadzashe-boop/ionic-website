---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import ContactSection from '@/components/ContactSection.astro';
import { site } from '@/data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const studies = await getCollection('caseStudies');
  return studies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
};

interface Props {
  study: CollectionEntry<'caseStudies'>;
}

const { study } = Astro.props;
const d = study.data;
const { Content } = await render(study);

const others = (await getCollection('caseStudies'))
  .filter((s) => s.id !== study.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const url = new URL(`/case-studies/${study.id}/`, site.domain).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.summary,
    about: { '@type': 'Organization', name: d.client },
    author: { '@type': 'Organization', name: site.name, url: site.domain },
    publisher: { '@type': 'Organization', name: site.name, url: site.domain },
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.domain + '/' },
      { '@type': 'ListItem', position: 2, name: 'Case studies', item: new URL('/case-studies/', site.domain).href },
      { '@type': 'ListItem', position: 3, name: d.client, item: url },
    ],
  },
];

const facts = [
  { label: 'Client', value: d.client },
  { label: 'Sector', value: d.sector },
  { label: 'Region', value: d.region },
  { label: 'Stage', value: d.stage },
  { label: 'Platforms', value: d.products.join(', ') },
];
---

<PageLayout
  title={`${d.client}: ${d.engagement} | ${site.name}`}
  description={d.summary}
  schema={schema}
>
  <article>
    <!-- ══ HEADER ═════════════════════════════════════════════════════ -->
    <header class="relative overflow-hidden">

      <div class="shell relative pb-16 pt-14 md:pb-20">
        <Breadcrumbs
          trail={[
            { label: 'Home', href: '/' },
            { label: 'Case studies', href: '/case-studies/' },
            { label: d.client },
          ]}
        />

        <p class="marker mt-12" style="animation:rise 0.9s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:60ms">
          {d.engagement}
        </p>

        <h1
          class="mt-6 max-w-4xl font-display"
          style="font-size:clamp(2rem,4.4vw,3.5rem);line-height:1.06;animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:150ms"
        >
          {d.title}
        </h1>

        <div class="rule mt-9 w-28" style="animation-delay:300ms"></div>

        <p class="t-lede measure mt-9 text-fg-3" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:360ms">
          {d.summary}
        </p>
      </div>
    </header>

    <!-- ══ FACT STRIP ═════════════════════════════════════════════════ -->
    <div class="border-t border-line">
      <div class="shell">
        <dl class="grid grid-cols-2 gap-x-8 gap-y-7 py-10 sm:grid-cols-3 lg:grid-cols-5">
          {
            facts.map((f, i) => (
              <div class="rise" style={`--step:${i}`}>
                <dt class="font-mono text-[0.625rem] uppercase tracking-[0.14em] text-fg-4">{f.label}</dt>
                <dd class="mt-2 text-sm text-fg">{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    {
      d.highlights.length > 0 && (
        <div class="border-t border-line">
          <div class="shell">
            {/* Highlight values are not all numeric. "All business units" is a
                phrase. Sizing them like hero figures made the strip unreadable,
                so short values get display treatment and long ones stay small. */}
            <dl class="grid grid-cols-1 gap-px bg-line-strong sm:grid-cols-3">
              {d.highlights.map((h, i) => (
                <div class="rise bg-base px-5 py-8 md:px-8" style={`--step:${i}`}>
                  <dd
                    class:list={[
                      'figure text-fg',
                      h.value.length <= 8 ? 'text-[clamp(1.75rem,3vw,2.5rem)]' : 'text-[clamp(1.125rem,1.7vw,1.375rem)]',
                    ]}
                    style="line-height:1.05"
                  >
                    {h.value}
                  </dd>
                  <dt class="mt-3 font-mono text-[0.625rem] uppercase tracking-[0.14em] text-fg-4">{h.label}</dt>
                </div>
              ))}
            </dl>
          </div>
        </div>
      )
    }

    <!-- ══ BODY ═══════════════════════════════════════════════════════ -->
    <div class="border-t border-line">
      <div class="shell py-20 md:py-28">
        <div class="grid gap-14 lg:grid-cols-[1fr_0.42fr] lg:gap-20">
          <div class="prose-tech rise">
            <Content />
          </div>

          <!-- Pull quote, sticky alongside the narrative -->
          <aside class="rise lg:sticky lg:top-28 lg:self-start" style="--step:1">
            <figure class="surface  p-8">
              <svg width="26" height="20" viewBox="0 0 26 20" class="text-primary" aria-hidden="true">
                <path
                  d="M10.6 0v3.9C7.4 4.6 5.8 6.5 5.8 9.5h4.1V20H0V9.9C0 4 3.5.6 10.6 0Zm15.4 0v3.9c-3.2.7-4.8 2.6-4.8 5.6h4.1V20h-9.9V9.9C15.4 4 18.9.6 26 0Z"
                  fill="currentColor"
                />
              </svg>

              <blockquote class="mt-5 font-display text-[1.0625rem] italic leading-relaxed text-fg">
                {d.quote}
              </blockquote>

              <figcaption class="mt-6 border-t border-line pt-5">
                <p class="text-sm text-fg-3">{d.quoteAttribution}</p>
                <p class="mt-1 font-mono text-[0.6875rem] text-fg-4">{d.engagement}</p>
              </figcaption>
            </figure>

            <p class="mt-5 font-mono text-[0.625rem] leading-relaxed text-fg-4">
              Attributed at organisation level.
            </p>
          </aside>
        </div>
      </div>
    </div>

    <!-- ══ MORE ═══════════════════════════════════════════════════════ -->
    <div class="border-t border-line">
      <div class="shell py-20 md:py-24">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <h2 class="t-section rise font-display">Other engagements</h2>
          <a href="/case-studies/" class="link-u rise pb-2 text-sm" style="--step:1">All case studies →</a>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {others.map((s, i) => <CaseStudyCard study={s} index={i} compact />)}
        </div>
      </div>
    </div>
  </article>

  <ContactSection
    source={`Case study: ${d.client}`}
    returnPath={`/case-studies/${study.id}/`}
    title="Discuss a similar engagement"
    lede="If this resembles a problem you're carrying, tell us about it. We reply within one business day."
  />
</PageLayout>
