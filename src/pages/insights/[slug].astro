---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Figure from '@/components/Figure.astro';
import { site, contact } from '@/data/site';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

interface Props {
  post: CollectionEntry<'insights'>;
}

const { post } = Astro.props;
const d = post.data;
const { Content } = await render(post);

const all = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
const others = all.filter((p) => p.id !== post.id).slice(0, 2);

const url = new URL(`/insights/${post.id}/`, site.domain).href;
const fmt = (dt: Date) =>
  dt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    author: { '@type': 'Organization', name: d.author, url: site.domain },
    publisher: { '@type': 'Organization', name: site.name, url: site.domain },
    keywords: d.topics.join(', '),
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.domain + '/' },
      { '@type': 'ListItem', position: 2, name: 'Insights', item: new URL('/insights/', site.domain).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<PageLayout title={`${d.title} | ${site.name}`} description={d.description} schema={schema}>
  <article>
    <header class="relative overflow-hidden">

      <div class="shell relative pb-14 pt-14 md:pb-16">
        <Breadcrumbs
          trail={[
            { label: 'Home', href: '/' },
            { label: 'Insights', href: '/insights/' },
            { label: d.title },
          ]}
        />

        <div class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-2" style="animation:rise 0.9s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:60ms">
          <time datetime={d.published.toISOString()} class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-4">
            {fmt(d.published)}
          </time>
          <span class="h-1 w-1 rounded-full bg-line-strong" aria-hidden="true"></span>
          <span class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-4">
            {d.readingMinutes} min read
          </span>
          {
            d.topics.map((t) => (
              <span class="rounded-full border border-line px-3 py-1 font-mono text-[0.625rem] text-fg-3">
                {t}
              </span>
            ))
          }
        </div>

        <h1
          class="measure mt-7 font-display"
          style="font-size:clamp(2rem,4.2vw,3.25rem);line-height:1.08;animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:150ms"
        >
          {d.title}
        </h1>

        <div class="rule mt-8 w-24" style="animation-delay:300ms"></div>

        <p class="t-lede measure mt-8 text-fg-3" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:360ms">
          {d.description}
        </p>
      </div>
    </header>

    {
      d.photo && (
        <div class="shell">
          <div class="lift -mt-2 mb-2">
            <Figure photo={d.photo} sizes="(min-width: 1024px) 68rem, 100vw" ratio="21 / 9" eager />
          </div>
        </div>
      )
    }

    <div class="border-t border-line">
      <div class="shell py-16 md:py-20">
        <div class="prose-tech rise">
          <Content />
        </div>

        <aside class="surface measure rise mt-20  p-8">
          <p class="marker">Talk to us</p>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-fg-3">
            If this describes a problem you're carrying, we'd rather hear about the specifics than
            write about it in general.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-5">
            <a href="/contact/" class="btn">
              Start a conversation
            </a>
            <a href={`mailto:${contact.email}`} class="link-u font-mono text-xs">{contact.email}</a>
          </div>
        </aside>
      </div>
    </div>

    {
      others.length > 0 && (
        <div class="border-t border-line">
          <div class="shell py-16 md:py-20">
            <h2 class="t-section rise font-display">Keep reading</h2>

            <ul class="mt-10 grid gap-5 md:grid-cols-2">
              {others.map((p, i) => (
                <li>
                  <a
                    href={`/insights/${p.id}/`}
                    class="surface rise group flex h-full flex-col  p-7"
                    style={`--step:${i}`}
                  >
                    <time datetime={p.data.published.toISOString()} class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-fg-4">
                      {fmt(p.data.published)}
                    </time>
                    <h3 class="mt-4 font-display text-lg leading-snug text-fg">{p.data.title}</h3>
                    <p class="mt-3 text-sm leading-relaxed text-fg-3">{p.data.description}</p>
                    <span class="mt-auto flex items-center gap-2 pt-6 text-xs text-fg-3 transition-colors group-hover:text-primary">
                      Read
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">
                        <path d="M2 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
  </article>
</PageLayout>
