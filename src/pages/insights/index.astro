---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Figure from '@/components/Figure.astro';
import { site } from '@/data/site';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);

const topics = [...new Set(posts.flatMap((p) => p.data.topics))].sort();

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${site.name} — Insights`,
  url: new URL('/insights/', site.domain).href,
  publisher: { '@type': 'Organization', name: site.name, url: site.domain },
};
---

<PageLayout
  title={`Insights — process automation, GRC and transformation | ${site.name}`}
  description="Practical writing on enterprise process automation, governance and risk, and why transformation programmes succeed or fail — from the team delivering them."
  schema={schema}
>
  <section class="relative overflow-hidden">

    <div class="shell relative pb-16 pt-14 md:pb-20">
      <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Insights' }]} />

      <h1 class="t-title mt-12 font-display" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:80ms">
        Insights
      </h1>

      <div class="rule mt-8 w-28" style="animation-delay:260ms"></div>

      <p class="t-lede measure mt-8 text-fg-3" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:320ms">
        What we've learned delivering transformation programmes — written for the people who have to
        make them work, not for search engines.
      </p>

      {
        topics.length > 0 && (
          <ul class="mt-11 flex flex-wrap gap-2" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:440ms">
            {topics.map((t) => (
              <li class="rounded-full border border-line px-3.5 py-1.5 font-mono text-[0.6875rem] text-fg-3">
                {t}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="border-t border-line">
    <div class="shell py-16 md:py-20">
      {
        posts.length === 0 ? (
          <p class="text-fg-3">Nothing published yet — the first pieces are on their way.</p>
        ) : (
          <ul class="space-y-0">
            {posts.map((post, i) => (
              <li>
                <a
                  href={`/insights/${post.id}/`}
                  class="rise group grid gap-5 border-b border-line py-9 transition-colors duration-500 hover:border-primary md:grid-cols-[7rem_8.5rem_minmax(0,1fr)] md:gap-7"
                  style={`--step:${i}`}
                >
                  {post.data.photo ? (
                    <Figure
                      photo={post.data.photo}
                      class="hidden md:block"
                      sizes="7rem"
                      ratio="4 / 3"
                      showCaption={false}
                    />
                  ) : (
                    <span class="hidden md:block" />
                  )}

                  <div class="flex flex-col gap-1.5">
                    <time datetime={post.data.published.toISOString()} class="font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-fg-4">
                      {fmt(post.data.published)}
                    </time>
                    <span class="font-mono text-[0.6875rem] text-fg-4">
                      {post.data.readingMinutes} min read
                    </span>
                  </div>

                  <div>
                    <h2 class="font-display text-[1.375rem] leading-snug text-fg transition-colors md:text-[1.625rem]">
                      {post.data.title}
                    </h2>
                    <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-fg-3">
                      {post.data.description}
                    </p>

                    <span class="mt-5 inline-flex items-center gap-2 text-xs text-fg-3 transition-colors group-hover:text-primary">
                      Read
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-500 group-hover:translate-x-1" aria-hidden="true">
                        <path d="M2 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <p class="mt-14">
        <a href="/rss.xml" class="link-u font-mono text-xs">RSS feed →</a>
      </p>
    </div>
  </section>
</PageLayout>
