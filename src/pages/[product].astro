---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHead from '@/components/SectionHead.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Figure from '@/components/Figure.astro';
import ContactSection from '@/components/ContactSection.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import Compass from '@/components/Compass.astro';
import CompassPreview from '@/components/CompassPreview.astro';
import TasterEmbed from '@/components/TasterEmbed.astro';
import { taster } from '@/data/site';
import { site, metrics, metricsNote } from '@/data/site';
import VideoFigure from '@/components/VideoFigure.astro';

/**
 * One template for every product. Adding a fifth platform is a Markdown
 * file. No new page, no duplicated markup. This is the single biggest
 * structural gain over the previous site, where each product page was a
 * near-identical hand-maintained copy.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { product: product.data.slug },
    props: { product },
  }));
};

/** Props arriving from getStaticPaths, declared so the entry stays typed. */
interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const d = product.data;
const { Content } = await render(product);

// Case studies that name this product.
const related = (await getCollection('caseStudies'))
  .filter((s) => s.data.products.includes(d.name))
  .sort((a, b) => a.data.order - b.data.order);

/**
 * The Compass is a real, free, in-browser tool, so it gets its own
 * WebApplication entry rather than being folded into the platform's. It
 * carried this schema on the page it used to have; dropping it on the move
 * would have quietly cost the structured data.
 */
const compassSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Process Compass',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  url: new URL(`/${d.slug}/#compass`, site.domain).href,
  publisher: { '@type': 'Organization', name: site.name },
  isPartOf: { '@type': 'SoftwareApplication', name: d.name },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description:
    'Five questions about one of your processes, answered by moving instruments rather than filling in a form, and one recommendation for what to do first.',
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: d.name,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: d.seoDescription,
    url: new URL(`/${d.slug}/`, site.domain).href,
    provider: { '@type': 'Organization', name: site.name, url: site.domain },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.domain + '/' },
      { '@type': 'ListItem', position: 2, name: d.name, item: new URL(`/${d.slug}/`, site.domain).href },
    ],
  },
  ...(d.compass ? [compassSchema] : []),
  ...(d.video
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'VideoObject',
          name: d.video.title,
          description: d.video.description,
          thumbnailUrl: new URL(d.video.poster, site.domain).href,
          contentUrl: new URL(d.video.src, site.domain).href,
          uploadDate: d.video.uploadDate,
          duration: `PT${Math.floor(d.video.durationSeconds / 60)}M${d.video.durationSeconds % 60}S`,
          width: d.video.width,
          height: d.video.height,
          publisher: { '@type': 'Organization', name: site.name, url: site.domain },
        },
      ]
    : []),
  ...(d.faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: d.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---

<PageLayout
  title={`${d.seoTitle} | ${site.name}`}
  description={d.seoDescription}
  schema={schema}
>
  <!-- ══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">

    <div class="shell relative pb-20 pt-14 md:pb-28 md:pt-16">
      <Breadcrumbs trail={[{ label: 'Home', href: '/' }, { label: 'Platforms', href: '/#platforms' }, { label: d.name }]} />

      <div class="mt-20 grid gap-14 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <div>
          {
            d.flagship && (
              <span class="veil mb-6 inline-flex items-center gap-2 rounded-full border border-primary/60 px-3.5 py-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-primary" />
                <span class="font-mono text-[0.625rem] uppercase tracking-[0.14em] text-primary">
                  Flagship platform
                </span>
              </span>
            )
          }

          <h1 class="t-title font-display" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:80ms">
            {d.name}
          </h1>

          <p class="mt-5 font-display text-xl font-semibold text-primary" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:200ms">
            {d.kicker}
          </p>

          <div class="rule mt-9 w-28" style="animation-delay:320ms"></div>

          <p class="t-lede mt-9 text-fg-3" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:380ms">
            {d.lede}
          </p>

          <div class="mt-11 flex flex-wrap items-center gap-4" style="animation:rise 1s cubic-bezier(0.2,0.7,0.15,1) both;animation-delay:500ms">
            <a href="#contact" class="btn"><span>Request a demo</span></a>
            {
              d.compass ? (
                <a href="#compass" class="link-u px-1 text-sm">Try the Process Compass</a>
              ) : (
                <a href="#capabilities" class="link-u px-1 text-sm">See capabilities</a>
              )
            }
          </div>
        </div>

        <!-- Capability index: a table of contents that doubles as ornament -->
        <aside class="rise lg:pt-14" style="--step:2">
          {
            d.photo && (
              <div class="mb-8">
                {/* No ratio: Figure gives photography the 16/10 crop and leaves brand
                    artwork at its own shape, which this one needs because its
                    strapline runs close to the bottom edge. */}
                <Figure photo={d.photo} sizes="(min-width: 1024px) 30rem, 100vw" eager />
              </div>
            )
          }
          <p class="marker">Platform components</p>
          <ol class="mt-6 space-y-0">
            {
              d.capabilities.map((c, i) => (
                <li class="group flex items-baseline gap-4 border-b border-line py-3.5 transition-colors duration-300 hover:border-primary">
                  <span class="figure w-6 shrink-0 text-[0.6875rem] text-fg-4 transition-colors group-hover:text-primary">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-sm text-fg-3 transition-colors group-hover:text-fg">{c.name}</span>
                </li>
              ))
            }
          </ol>
        </aside>
      </div>
    </div>
  </section>

  {
    d.showMetrics && (
      <div class="seam">
        <div class="shell py-14 md:py-16">
          <div class="flex flex-wrap items-center gap-x-10 gap-y-5">
            <p class="mono-label">Reported outcomes</p>
            {metrics.map((m, i) => (
              <div class="flex items-baseline gap-2.5">
                <span class="figure text-[1.5rem] leading-none">
                  {m.value}
                  <span class="text-[0.7em]" style={`color: var(--${['d2', 'd3', 'd4'][i]})`}>{m.unit}</span>
                </span>
                <span class="font-mono text-[0.625rem] uppercase tracking-[0.1em] text-fg-4">{m.label}</span>
              </div>
            ))}
            <span class="font-mono text-[0.625rem] text-fg-4">As reported by clients</span>
          </div>

          {/* The basis travels with the number. A percentage with no stated
              comparison is the first thing questioned in procurement. */}
          <p class="measure mt-5 font-mono text-[0.625rem] leading-relaxed text-fg-4">{metricsNote}</p>
        </div>
      </div>
    )
  }

  <!-- ══ EXPLAINER VIDEO ═══════════════════════════════════════════════ -->
  {/* Second on the page, straight after the figures. Two and a half
      minutes of someone explaining it is the lowest-effort way in, and a
      reader who watches it meets the capability list already oriented. It
      sat sixth for a while, behind three consecutive enumerated sections,
      which is exactly the fatigue it exists to prevent. */}
  {
    d.video && (
      <section id="video" class="band-alt seam scroll-mt-20">
        <div class="shell py-32 md:py-44">
          <div class="grid gap-12 lg:grid-cols-[0.42fr_1fr] lg:gap-16">
            <div class="lg:sticky lg:top-28 lg:self-start">
              <SectionHead
                marker="See it work"
                title="Two and a half minutes,"
                titleAccent="start to finish."
              />
              <p class="measure mt-8 text-[0.9375rem] leading-relaxed text-fg-3">
                {d.video.description}
              </p>
              <p class="mt-8">
                <a href="#compass" class="link-u text-sm">Or try it on your own process →</a>
              </p>
            </div>

            <div class="rise" style="--step:1">
              <VideoFigure
                src={d.video.src}
                poster={d.video.poster}
                durationSeconds={d.video.durationSeconds}
                title={d.video.title}
                captions={d.video.captions}
                ratio={`${d.video.width} / ${d.video.height}`}
                autoplay
              />
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ══ CAPABILITIES ══════════════════════════════════════════════════ -->
  <section id="capabilities" class="border-t border-line scroll-mt-20">
    <div class="shell py-32 md:py-44">
      <SectionHead
        marker="Capabilities"
        title={d.capabilities.length > 4 ? 'Six capabilities, one platform' : 'What the platform does'}
      />

      <div class="mt-20 grid gap-px overflow-hidden  border border-line bg-line-strong sm:grid-cols-2">
        {
          d.capabilities.map((c, i) => (
            <article class="rise group relative bg-base p-8 transition-colors duration-500 hover:bg-raised md:p-10" style={`--step:${i}`}>
              <span class="figure text-xs text-primary">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-5 font-display text-xl leading-snug text-fg">{c.name}</h3>
              <p class="mt-3.5 text-sm leading-relaxed text-fg-3">{c.detail}</p>
              <span class="absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-primary transition-transform duration-700 ease-out group-hover:scale-x-100" />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══ JOURNEY ═══════════════════════════════════════════════════════ -->
  {/* Capabilities say what the platform contains. This says what happens to
      your process, in order, which is the thing a buyer follows. */}
  {
    d.journey.length > 0 && (
      <section id="journey" class="border-t border-line scroll-mt-20">
        <div class="shell py-32 md:py-44">
          <SectionHead
            marker="What it does"
            title="The whole journey,"
            titleAccent="in one place."
            lede="Most programmes stitch this together from workshops, a deck, a mapping tool, a requirements tool and a project tracker. Each handover is somewhere meaning gets lost."
          />

          <ol class="mt-20 space-y-0">
            {d.journey.map((j, i) => (
              <li
                class="rise group grid gap-5 border-b border-line py-8 transition-colors duration-500 hover:border-primary md:grid-cols-[0.14fr_0.3fr_1fr] md:gap-10"
                style={`--step:${i}`}
              >
                <span class="figure text-xs text-primary">{String(i + 1).padStart(2, '0')}</span>
                <span class="mono-label self-baseline">{j.stage}</span>
                <div>
                  <h3 class="font-display text-lg text-fg">{j.name}</h3>
                  <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-fg-3">{j.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <!-- ══ AUDIENCES ═════════════════════════════════════════════════════ -->
  {
    d.audiences.length > 0 && (
      <section class="border-t border-line">
        <div class="shell py-32 md:py-44">
          <SectionHead marker="Who it is for" title="Business and IT, working from the same picture" />

          <div class="mt-20 grid gap-px overflow-hidden border border-line bg-line-strong md:grid-cols-3">
            {d.audiences.map((a, i) => (
              <article class="rise bg-base p-8 md:p-10" style={`--step:${i}`}>
                <p class="mono-label">{a.who}</p>
                <h3 class="mt-5 font-display text-xl leading-snug text-fg">{a.name}</h3>
                <p class="mt-3.5 text-sm leading-relaxed text-fg-3">{a.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ══ NARRATIVE (Markdown body) ═════════════════════════════════════ -->
  <section class="border-t border-line">
    <div class="shell py-32 md:py-44">
      <div class="grid gap-14 lg:grid-cols-[0.32fr_1fr] lg:gap-20">
        <p class="marker rise lg:pt-3">In depth</p>
        <div class="prose-tech rise" style="--step:1">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <!-- ══ TRACTION ══════════════════════════════════════════════════════ -->
  <section class="border-t border-line">
    <div class="shell py-32 md:py-44">
      <SectionHead marker="Traction" title={d.traction.heading} />

      <div class="mt-16 space-y-0">
        {
          d.traction.items.map((item, i) => (
            <div
              class="rise group grid gap-4 border-b border-line py-8 transition-colors duration-500 hover:border-primary md:grid-cols-[0.3fr_1fr] md:gap-10"
              style={`--step:${i}`}
            >
              <h3 class="flex items-baseline gap-3 font-display text-lg text-fg">
                <span class="h-1.5 w-1.5 shrink-0 translate-y-[-0.2em] rounded-full bg-primary transition-transform duration-500 group-hover:scale-150" />
                {item.client}
              </h3>
              <p class="text-[0.9375rem] leading-relaxed text-fg-3">{item.detail}</p>
            </div>
          ))
        }
      </div>

      {
        related.length > 0 && (
          <div class="mt-20">
            <p class="marker rise">Read the engagements</p>
            <div class="mt-8 grid gap-5 md:grid-cols-3">
              {related.slice(0, 3).map((s, i) => (
                <CaseStudyCard study={s} index={i} compact />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- ══ COMPASS ═══════════════════════════════════════════════════════ -->
  {/* Placed after traction and before contact on purpose: you read what the
      platform does, see that it has run somewhere real, then try the thing
      yourself, and the contact form is the next step rather than an
      interruption. */}
  {
    d.compass && (
      <section id="compass" class="band-alt seam scroll-mt-20">
        <div class="shell py-32 md:py-44">
          <SectionHead
            marker="Try it yourself"
            title="A discovery pass,"
            titleAccent="in about two minutes."
            lede={`Every ${d.name} engagement opens with discovery: we map how the work actually runs before a single thing is configured. The Compass is that first conversation in miniature, run on one of your own processes. Nothing is sent anywhere and nothing is stored, so you can answer honestly.`}
          />

          {/* The instruments, shown before anything is clicked. The Compass
              itself reveals one stage at a time, so at rest the section was
              an intro panel and a button, and the questions it asks were
              invisible to anyone who did not start it. */}
          <div class="mt-20">
            <CompassPreview />
          </div>

          <div class="mt-24 border-t border-line pt-24">
            <div class="mb-12 flex flex-wrap items-baseline justify-between gap-4">
              <p class="marker"><b>03</b><span>Take the reading</span></p>
              <p class="font-mono text-[0.6875rem] text-fg-4">Runs in your browser · nothing is stored</p>
            </div>
            <Compass />
          </div>
        </div>
      </section>
    )
  }

  <!-- ══ TASTER ════════════════════════════════════════════════════════ -->
  {/* The deeper version of the Compass above: the real platform, running on
      your own process, rather than our rule of thumb about it. Renders
      nothing at all until the PG host is configured. */}
  {
    d.compass && taster.host && (
      <section id="taster" class="border-t border-line scroll-mt-20">
        <div class="shell py-32 md:py-44">
          <SectionHead
            marker="Run the real thing"
            title="Five questions,"
            titleAccent="and the platform answers."
            lede={`The Compass above is our rule of thumb. This is ${d.name} itself: describe one process and it draws how it runs today against the improved flow, then generates a preview of the system behind it. It takes about a minute to think, which is the honest cost of it being real.`}
          />

          <div class="mt-20">
            <TasterEmbed contactPath="/contact/?topic=taster" />
          </div>
        </div>
      </section>
    )
  }

  <!-- ══ FAQ ═══════════════════════════════════════════════════════════ -->
  {
    d.faqs.length > 0 && (
      <section id="faqs" class="border-t border-line scroll-mt-20">
        <div class="shell py-32 md:py-44">
          <SectionHead marker="Questions" title={`Common questions about ${d.name}`} />

          <div class="mt-16 border-t border-line">
            {d.faqs.map((f, i) => (
              <details class="faq-row rise group border-b border-line" style={`--step:${i}`}>
                <summary class="flex cursor-pointer list-none items-baseline justify-between gap-6 py-6 text-left">
                  <span class="font-display text-[1.0625rem] leading-snug text-fg">{f.q}</span>
                  <span class="faq-mark shrink-0 font-mono text-sm text-fg-4" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p class="measure pb-7 text-[0.9375rem] leading-relaxed text-fg-3">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ══ CONTACT ═══════════════════════════════════════════════════════ -->
  <ContactSection
    source={`${d.name} page`}
    returnPath={`/${d.slug}/`}
    title={`See ${d.name} in action`}
    lede={`Tell us how your operations run today and we'll show you what ${d.name} changes. We reply within one business day.`}
  />
</PageLayout>

<style>
  .faq-row summary::-webkit-details-marker { display: none; }
  .faq-row .faq-mark { transition: transform 0.35s var(--ease-out-soft), color 0.35s; }
  .faq-row[open] .faq-mark { transform: rotate(45deg); color: var(--primary); }
  .faq-row summary:hover .faq-mark { color: var(--primary); }
</style>
