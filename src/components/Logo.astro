---
/**
 * The Ionic Innovate logo, from the supplied artwork.
 *
 * Replaces both an invented arc-and-arrowhead mark that was never the
 * company's logo, and the vector reconstruction that stood in for it.
 *
 * Two variants ship for each lockup, because the supplied ink is a near-black
 * navy: on this site's ground it measured luminance 0.01 against 0.016 and
 * was effectively invisible. `-on-dark` recolours that ink to near-white and
 * leaves the yellow untouched; `-on-light` is the artwork as supplied.
 *
 * Which one shows is pure CSS, keyed off exactly the same conditions that
 * drive the palette, so a logo dropped inside a pale band flips with it. No
 * JavaScript, so it is correct in the server-rendered HTML.
 */
interface Props {
  /** `lockup` is horizontal; `stacked` puts the wordmark under the mark. */
  variant?: 'lockup' | 'stacked';
  /** Rendered width in px. Height follows the artwork's own ratio. */
  width?: number;
  class?: string;
}

const { variant = 'lockup', width = 132, class: className = '' } = Astro.props;

/** Intrinsic sizes, so the browser reserves the right box and never shifts. */
const BOX = {
  lockup: { w: 760, h: 304 },
  stacked: { w: 520, h: 451 },
} as const;

const box = BOX[variant];
const height = Math.round((width * box.h) / box.w);
const base = `/brand/ionic-${variant}`;
---

<span class={`logo-swap relative inline-block shrink-0 ${className}`} style={`width:${width}px;height:${height}px`}>
  <img
    src={`${base}-on-dark.png`}
    alt="Ionic Innovate"
    width={box.w}
    height={box.h}
    decoding="async"
    class="logo-on-dark absolute inset-0 h-full w-full object-contain"
  />
  <img
    src={`${base}-on-light.png`}
    alt=""
    aria-hidden="true"
    width={box.w}
    height={box.h}
    decoding="async"
    class="logo-on-light absolute inset-0 h-full w-full object-contain"
  />
</span>

<style is:global>
  /* Dark ground by default, so the light-ink artwork shows. Each rule below
     mirrors one of the palette's ground conditions. Only the alt text on the
     visible one is read, because the hidden twin is aria-hidden and the pair
     never both display. */
  .logo-on-light { display: none; }

  .light .logo-on-dark,
  .band-alt .logo-on-dark { display: none; }
  .light .logo-on-light,
  .band-alt .logo-on-light { display: block; }

  /* A pale band inside the light theme is dark again, so it flips back. */
  .light .band-alt .logo-on-dark { display: block; }
  .light .band-alt .logo-on-light { display: none; }
</style>
