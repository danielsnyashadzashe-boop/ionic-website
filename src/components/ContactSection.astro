---
import ContactForm from './ContactForm.tsx';
import SectionHead from './SectionHead.astro';
import Figure from './Figure.astro';
import { contact, localityLine, site } from '@/data/site';

interface Props {
  source: string;
  returnPath: string;
  n?: string;
  title?: string;
  titleAccent?: string;
  lede?: string;
  showInvestor?: boolean;
}

const {
  source,
  returnPath,
  n = '07',
  title = 'Start a',
  titleAccent = 'conversation.',
  lede,
  showInvestor = false,
} = Astro.props;

const facts = [
  { label: 'Email', value: contact.email, href: `mailto:${contact.email}`, mono: true, copy: true },
  ...(showInvestor
    ? [{ label: 'Investment', value: contact.investorEmail, href: `mailto:${contact.investorEmail}`, mono: true, copy: true }]
    : []),
  { label: 'Locations', value: localityLine, mono: false },
  { label: 'Reply time', value: `A real person, ${site.responseTime}`, mono: false },
];
---

<section id="contact" class="seam relative scroll-mt-16 overflow-hidden">
  <div class="halo right-[-12rem] top-10 h-[26rem] w-[26rem]"></div>

  {/* Bordered invitation panel, as the model site closes its homepage: a
      framed block with a short line, one button, and an image holding the
      right side. It sits above the form so the page asks before it demands
      a dozen fields. */}
  <div class="shell relative pt-32 md:pt-44">
    <div class="surface rise relative overflow-hidden border border-primary/25 px-7 py-14 md:px-16 md:py-20">
      <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
        <div>
          <h2 class="t-title">
            Interested?
          </h2>
          <p class="t-lede measure mt-5 text-fg-2">
            Tell us what you are trying to change. A no-obligation discovery call, and a real
            person replies {site.responseTime}.
          </p>
          <a href={`mailto:${contact.email}`} class="btn-ghost mt-8 inline-flex">
            <span>Book a discovery call</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <Figure photo="deliveryTeam" showCaption={false} ratio="4 / 3" sizes="(min-width: 1024px) 22rem, 90vw" float />
      </div>
    </div>
  </div>

  <div class="shell relative py-32 md:py-44">
    <SectionHead {n} marker="Contact" {title} {titleAccent} {lede} />

    <div class="mt-20 grid gap-6 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
      <dl class="surface divide-y divide-line overflow-hidden">
        {
          facts.map((f, i) => (
            <div class="rise px-5 py-4" style={`--step:${i}`}>
              <dt class="mono-label">{f.label}</dt>
              <dd class="mt-1.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                {f.href ? (
                  <a href={f.href} class:list={['link-u text-[0.9375rem]', f.mono && 'font-mono text-[0.875rem]']}>
                    {f.value}
                  </a>
                ) : (
                  <span class="text-[0.9375rem] text-fg-3">{f.value}</span>
                )}
                {/* mailto: is unreliable for anyone without a mail client
                    configured, so the address is also copyable. */}
                {f.copy && (
                  <button
                    type="button"
                    class="copy-addr -my-2 inline-flex min-h-[1.75rem] items-center px-1.5 py-2 font-mono text-[0.625rem] uppercase tracking-[0.1em] text-fg-4 transition-colors hover:text-primary"
                    data-copy={f.value}
                  >
                    Copy
                  </button>
                )}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="surface rise p-6 md:p-8" style="--step:2">
        <ContactForm {source} {returnPath} action={contact.formAction} email={contact.email} client:visible />
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Copy the address to the clipboard.
   *
   * writeText is refused in some embedded views, so the rejection is caught
   * and the button says so rather than silently claiming success.
   */
  document.querySelectorAll<HTMLButtonElement>('.copy-addr').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const value = btn.dataset.copy ?? '';
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select it';
      }
      window.setTimeout(() => (btn.textContent = original), 2000);
    });
  });
</script>
