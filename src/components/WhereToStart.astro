---
import { contact } from '@/data/site';
import { questions } from '@/data/where-to-start';

/**
 * Five questions, one at a time, then one recommendation.
 *
 * The content is the reference prototype's: see data/where-to-start.ts.
 * The presentation deliberately is not. The first build of this gave each
 * question a draggable SVG instrument and a preview band showing all the
 * instruments before you started, put a product name on it and gave that
 * name a nav slot. It was the busiest thing on the site and the name meant
 * nothing to anyone who had not been in the room. All of that is gone.
 * What is left is a list of answers you click.
 *
 * Clicking an answer selects it and moves on, so the whole thing is five
 * clicks and a read. There is no Next button to find, and no Start screen
 * in front of the first question — the section heading above already says
 * what this is.
 *
 * Staging, the rail and the keyboard handling come from lib/stages.ts, the
 * same controller the contact brief uses, so the interaction is learned
 * once.
 */
---

<div class="surface overflow-hidden" data-stages data-wts>
  <div class="flex items-center gap-6 border-b border-line px-6 py-4 md:px-9">
    <div class="stage-rail flex-1" data-stage-rail><b></b></div>
    <p class="stage-count shrink-0" data-stage-count></p>
  </div>

  <div class="px-6 py-12 md:px-9 md:py-16">
    {
      questions.map((q, i) => (
        <section class:list={['stage', i === 0 && 'is-on']} data-stage={q.key}>
          <p class="marker">
            <b>{String(i + 1).padStart(2, '0')}</b>
            <span>{q.marker}</span>
          </p>
          <h2 class="t-section mt-4" tabindex="-1">{q.title}</h2>
          <p class="measure mt-3.5 text-[0.9375rem] leading-relaxed text-fg-3">{q.copy}</p>

          {/* A group of buttons, not a radio group. Clicking one answers
              and moves on, so there is nothing to review and change before
              submitting, and no arrow-key selection to implement. Coming
              back marks what you chose with aria-current. */}
          <div class="mt-9 grid gap-2" role="group" aria-label={q.title}>
            {q.options.map((o, j) => (
              <button type="button" class="opt" data-opt data-q={q.key} data-i={j}>
                <span class="opt-text">
                  <b>{o.label}</b>
                  <small>{o.note}</small>
                </span>
                <span class="opt-go" aria-hidden="true">
                  →
                </span>
              </button>
            ))}
          </div>

          {i > 0 && (
            <button type="button" class="btn-ghost mt-9" data-back>
              Back
            </button>
          )}
        </section>
      ))
    }

    <!-- ══ Recommendation ══ -->
    <section class="stage" data-stage="result">
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-5" data-readings></dl>

      <div class="mt-12">
        <p class="marker"><b>—</b><span>Recommendation</span></p>
        <h2 class="t-title mt-4" data-v-title tabindex="-1"></h2>
        <p class="t-lede measure mt-5 text-fg-2" data-v-why></p>
        <p class="measure mt-4 text-[0.9375rem] leading-relaxed text-fg-3" data-v-summary></p>

        <h3 class="mt-12 font-display text-[1.125rem] text-fg">Where we would start</h3>
        <ol class="mt-5 grid max-w-[34rem] gap-3" data-v-steps></ol>
        <p class="mt-5 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-fg-4" data-v-time></p>

        <div class="mt-11 flex flex-wrap items-center gap-4">
          <a class="btn" href="/contact/"><span>Book a working session</span><span aria-hidden="true">→</span></a>
          <button type="button" class="btn-ghost" data-restart>Start again</button>
        </div>

        {/* The boss's note was that there is invented material on this site.
            This is a rule of thumb and says so, in the same breath as the
            answer, rather than in small print somewhere else. */}
        <p class="measure mt-7 text-[0.8125rem] leading-relaxed text-fg-4">
          This is a rule of thumb, not an assessment. It reflects what you told us here and
          nothing else, and none of it leaves your browser. Email{' '}
          <a class="link-u" href={`mailto:${contact.email}`}>{contact.email}</a> if you would
          rather talk it through.
        </p>
      </div>
    </section>
  </div>
</div>

{/*
  `is:global`, deliberately, for the parts JavaScript builds. Astro scopes
  component styles by stamping a data attribute on the markup it renders,
  and the readings cells and recommendation steps are created at runtime,
  so they never carry it and scoped rules skip them silently. Every
  selector is prefixed with [data-wts] so going global does not leak.
*/}
<style is:global>
  /* One answer. A row, not a card: five questions of card grids was the
     density the feedback was about. */
  [data-wts] .opt {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0.85rem 1.1rem;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg);
    transition: border-color 0.25s, background 0.25s, transform 0.25s var(--ease-spring);
  }
  [data-wts] .opt-text { display: grid; gap: 0.15rem; min-width: 0; }
  [data-wts] .opt-text b { font-weight: 500; font-size: 1rem; letter-spacing: -0.01em; }
  [data-wts] .opt-text small {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--fg-4);
  }
  [data-wts] .opt-go {
    margin-left: auto;
    flex: none;
    color: var(--fg-4);
    opacity: 0;
    transform: translateX(-0.35rem);
    transition: opacity 0.25s, transform 0.25s var(--ease-out-soft);
  }
  [data-wts] .opt:hover,
  [data-wts] .opt:focus-visible {
    border-color: var(--primary);
    background: color-mix(in oklch, var(--primary) 7%, transparent);
  }
  [data-wts] .opt:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  [data-wts] .opt:hover .opt-go,
  [data-wts] .opt:focus-visible .opt-go { opacity: 1; transform: none; }

  /* Held for the beat between the click and the next question, so the
     answer you chose is visible before the panel changes, and again if
     you come back to it. */
  [data-wts] .opt[data-chosen] {
    border-color: var(--primary);
    background: color-mix(in oklch, var(--primary) 14%, transparent);
  }
  /* The tint costs the note about a point of contrast and 13px has none
     to spare: measured, it landed on 4.50 light and 4.20 dark. The
     chosen row's note moves up a step rather than the tint coming off. */
  [data-wts] .opt[data-chosen] .opt-text small { color: var(--fg-3); }

  /* Five readings in a two-column grid leaves a hole; the odd one out
     takes the whole row instead. */
  @media (width < 48rem) {
    [data-wts] [data-readings] > div:last-child:nth-child(odd) { grid-column: span 2; }
  }

  [data-wts] [data-v-steps] li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--fg-2);
  }
  [data-wts] [data-v-steps] li i {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.9;
    color: var(--primary);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-wts] .opt,
    [data-wts] .opt-go { transition: none; }
    [data-wts] .opt-go { opacity: 1; transform: none; }
  }
</style>

<script>
  import { mountStages } from '@/lib/stages';
  import { questions, tracks, choose, why, type Answers } from '@/data/where-to-start';

  const root = document.querySelector<HTMLElement>('[data-wts]');
  if (root) {
    const stages = mountStages(root);
    const answers: Answers = {};

    const opts = [...root.querySelectorAll<HTMLButtonElement>('[data-opt]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    opts.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.q!;
        const q = questions.find((x) => x.key === key)!;
        const o = q.options[Number(btn.dataset.i)];
        answers[key] = { value: o.value, label: o.label, note: o.note, reads: o.reads };

        // Only within this question, so going back shows what you picked.
        root.querySelectorAll(`[data-opt][data-q="${key}"]`).forEach((other) => {
          other.toggleAttribute('data-chosen', other === btn);
          if (other === btn) other.setAttribute('aria-current', 'true');
          else other.removeAttribute('aria-current');
        });

        // A beat, so the selection registers before the panel moves.
        window.setTimeout(() => stages?.next(), reduced ? 0 : 260);
      });
    });

    root.querySelector('[data-restart]')?.addEventListener('click', () => {
      opts.forEach((o) => {
        o.removeAttribute('data-chosen');
        o.removeAttribute('aria-current');
      });
      for (const k of Object.keys(answers)) delete answers[k];
      stages?.go(questions[0].key);
    });

    const cell = (label: string, value: string) =>
      `<div class="bg-raised px-4 py-3.5"><dt class="mono-label">${label}</dt>` +
      `<dd class="figure mt-1.5 text-[1.0625rem] leading-tight">${value}</dd></div>`;

    root.addEventListener('stagechange', (e) => {
      if ((e as CustomEvent).detail.stage !== 'result') return;

      // Reachable by keyboard before every question is answered; send the
      // visitor back to the first gap rather than reasoning over nothing.
      const missing = questions.find((q) => !answers[q.key]);
      if (missing) {
        stages?.go(missing.key);
        return;
      }

      const key = choose(answers);
      const t = tracks[key];

      root.querySelector('[data-readings]')!.innerHTML = questions
        .map((q) => cell(q.readout, q.key === 'pain' ? answers[q.key].note : answers[q.key].label))
        .join('');

      root.querySelector('[data-v-title]')!.textContent = t.title;
      root.querySelector('[data-v-why]')!.textContent = why(key, answers);
      root.querySelector('[data-v-summary]')!.textContent = t.summary;

      const ol = root.querySelector('[data-v-steps]')!;
      ol.innerHTML = '';
      t.steps.forEach((s, i) => {
        const li = document.createElement('li');
        li.innerHTML = `<i>${String(i + 1).padStart(2, '0')}</i><span>${s}</span>`;
        ol.appendChild(li);
      });
      root.querySelector('[data-v-time]')!.textContent = t.time;
    });
  }
</script>
