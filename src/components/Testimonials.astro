---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';

/**
 * Testimonials.
 *
 * Drawn from the case studies rather than kept as a second list, so a quote
 * and its write-up can never disagree, and every card links to the engagement
 * it came from.
 *
 * Only studies that actually carry a quote appear. A study published before
 * its quote is cleared is simply absent, which is the correct behaviour: the
 * alternative is writing words for a client and attributing them, and that is
 * not something we do.
 */
const studies = (await getCollection('caseStudies'))
  .filter((s) => s.data.quote && s.data.quote.trim().length > 0)
  .sort((a, b) => a.data.order - b.data.order);

/** Longest first, so the masonry columns fill evenly rather than by accident. */
const ordered = [...studies].sort((a, b) => (b.data.quote!.length - a.data.quote!.length));

/**
 * Shout about unapproved wording on every build.
 *
 * A placeholder quote under a named individual is the kind of thing that
 * ships because nobody remembered it was there. This makes forgetting
 * impossible: the warning appears in every build and every dev start, and
 * only goes away when the flag is cleared in the content file.
 */
const pending = ordered.filter((s) => s.data.quotePending);
if (pending.length > 0) {
  console.warn(
    `\n  ⚠  ${pending.length} testimonial quote(s) are PLACEHOLDERS and not approved:\n` +
      pending.map((s) => `     - ${s.data.quoteAttribution}  (src/content/case-studies/${s.id}.md)`).join('\n') +
      `\n     Replace with real wording or remove before publishing.\n`,
  );
}
---

{
  ordered.length > 0 && (
    <section id="testimonials" class="band-alt seam scroll-mt-16">
      <div class="shell py-32 md:py-44">
        <SectionHead
          center
          marker="In their words"
          title="What clients say when"
          titleAccent="the work is done."
          lede="Taken from the engagements themselves. Every quote links to the write-up it came from, so you can read the whole story rather than the flattering sentence."
        />

        {/* Columns rather than a grid: quotes differ in length, and a grid
            would stretch every card to match the tallest in its row. */}
        <div class="mt-20 gap-6 sm:columns-2 lg:columns-3">
          {ordered.map((s, i) => (
            <a
              href={`/case-studies/${s.id}/`}
              class="surface card-i rise mb-6 block break-inside-avoid p-7 md:p-8"
              style={`--step:${i}`}
            >
              <svg
                width="24"
                height="19"
                viewBox="0 0 26 20"
                class="text-accent-warm"
                aria-hidden="true"
                style="color: var(--accent-warm)"
              >
                <path
                  d="M10.6 0v3.9C7.4 4.6 5.8 6.5 5.8 9.5h4.1V20H0V9.9C0 4 3.5.6 10.6 0Zm15.4 0v3.9c-3.2.7-4.8 2.6-4.8 5.6h4.1V20h-9.9V9.9C15.4 4 18.9.6 26 0Z"
                  fill="currentColor"
                />
              </svg>

              <blockquote class="mt-5 text-[1.0625rem] leading-relaxed text-fg-2">
                {s.data.quote}
              </blockquote>

              {/* Stacks below `sm`. Side by side, a long sector name such as
                  "Healthcare administration" was clipped at 320px, and a
                  truncated sector is worse than a wrapped one. */}
              <div class="mt-6 flex flex-col gap-2 border-t border-line pt-5 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
                <div class="min-w-0">
                  <p class="text-[0.9375rem] font-medium text-fg">
                    {s.data.quoteAttribution}
                  </p>
                  <p class="mt-1 font-mono text-[0.625rem] uppercase leading-relaxed tracking-[0.1em] text-fg-4">
                    {s.data.sector}
                  </p>
                </div>
                <span
                  class="shrink-0 font-mono text-[0.625rem] uppercase tracking-[0.1em] text-fg-4 transition-colors group-hover:text-fg-2"
                  aria-hidden="true"
                >
                  Read →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
