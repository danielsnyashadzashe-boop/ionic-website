---
interface Props {
  n?: string;
  marker?: string;
  title: string;
  /** Rendered in the primary accent, appended to the title. */
  titleAccent?: string;
  lede?: string;
  /** Centred, as the model site sets its section intros. */
  center?: boolean;
  class?: string;
}

const { n, marker, title, titleAccent, lede, center = false, class: className = '' } = Astro.props;
---

<header class:list={[className, center && 'mx-auto max-w-3xl text-center']}>
  {
    (n || marker) && (
      <p class="marker veil">
        {n && <b>{n}</b>}
        {n && marker && <span class="text-fg-4" aria-hidden="true">/</span>}
        {marker && <span>{marker}</span>}
      </p>
    )
  }

  <h2 class:list={['t-section rise mt-5', center ? 'mx-auto' : 'max-w-3xl']} style="--step:1">
    {title}
    {titleAccent && <> <span class="grad-text">{titleAccent}</span></>}
    <span class="slash" aria-hidden="true">/</span>
  </h2>

  {
    lede && (
      <p class:list={['t-lede rise mt-5 text-fg-3', center ? 'mx-auto max-w-2xl' : 'measure']} style="--step:2">
        {lede}
      </p>
    )
  }
</header>
