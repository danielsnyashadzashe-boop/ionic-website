---
import { getCollection } from 'astro:content';
import SectionHead from './SectionHead.astro';
import Gauge from './charts/Gauge.astro';
import BarsH from './charts/BarsH.astro';
import BarsV from './charts/BarsV.astro';
import Donut from './charts/Donut.astro';
import { projects, disciplines } from '@/data/projects';

/**
 * Impact dashboard.
 *
 * Every series is derived from the content collections or from a figure the
 * site publishes. Nothing is invented to make a panel look busier.
 *
 * These were React/Recharts islands until they were caught rendering blank.
 * Astro server-renders Recharts at a hardcoded 320x200 because there is no DOM
 * to measure, so the pre-hydration markup was a wrongly-sized empty chart; and
 * on a throttled connection the ~400KB of React + Recharts never arrived at
 * all, leaving the panels permanently empty. All of this data is known at build
 * time, so it is now static SVG: instant, works with JS disabled, and
 * impossible to leave blank.
 */

const studies = await getCollection('caseStudies');

const gauges = [
  { label: 'Faster processing', value: 85, display: '85%', tone: 'd2' },
  { label: 'Cost reduction', value: 60, display: '60%', tone: 'd3' },
  { label: 'Accuracy', value: 99, display: '99%+', tone: 'd4' },
];

/**
 * Discipline spread. One hue at varying intensity. Cycling six would imply a
 * categorical grouping that does not exist, and would repeat after six rows.
 */
const disciplineData = disciplines
  .map((label) => ({ label, value: projects.filter((p) => p.discipline === label).length }))
  .sort((a, b) => b.value - a.value);

/**
 * Two panels here used to publish sales-pipeline data: a donut of engagement
 * stages including "In discussion", and a cumulative "first contact to
 * production" chart, which is a funnel. Both are internal commercial
 * information. A prospect reading the funnel learns how thin the pipeline
 * is; a competitor learns the same thing. Replaced with what a buyer
 * actually wants to know, which is whether we have done this in their
 * industry and what kind of work it was.
 */
const sectors = [...new Set(studies.map((s) => s.data.sector))].sort();

const sectorTones = ['d1', 'd2', 'd3', 'd4', 'd5', 'd6'] as const;
const sectorData = sectors.map((label, i) => ({
  label,
  value: studies.filter((s) => s.data.sector === label).length,
  tone: sectorTones[i % sectorTones.length],
}));

const totalEngagements = projects.length;
---

<section id="impact" class="seam relative scroll-mt-16 overflow-hidden">
  <div class="halo -left-56 -top-24 h-[26rem] w-[26rem]"></div>

  <div class="shell relative pt-32 md:pt-44">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionHead
        n="03"
        marker="Impact"
        title="What the work"
        titleAccent="actually moves."
        lede="Reported outcomes from enterprise deployments, alongside the live shape of the portfolio."
      />
      <p class="chip rise" style="--step:3">
        <span class="pulse"></span>
        Derived from content, not hardcoded
      </p>
    </div>
  </div>

  <div class="shell relative pb-32 pt-20 md:pb-44">
    <div class="grid gap-6 lg:grid-cols-12 lg:gap-7">
      <!-- Reported outcomes -->
      <article class="surface rise min-w-0 p-8 md:p-10 lg:col-span-7">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-[0.9375rem] font-medium text-fg">Reported outcomes</h3>
          <span class="mono-label">As reported by clients</span>
        </div>
        <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-3">
          {gauges.map((g) => <Gauge {...g} />)}
        </div>
      </article>

      <!-- Sectors delivered in -->
      <article class="surface rise min-w-0 p-8 md:p-10 lg:col-span-5" style="--step:1">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-[0.9375rem] font-medium text-fg">Sectors delivered in</h3>
          <span class="mono-label">{sectors.length} sectors</span>
        </div>
        <div class="mt-7">
          <Donut slices={sectorData} centreValue={String(totalEngagements)} centreLabel="ENGAGEMENTS" />
        </div>
        <ul class="mt-7 grid grid-cols-2 gap-x-6 gap-y-2.5 border-t border-line pt-6">
          {
            sectorData.map((d) => (
              <li class="flex items-center justify-between gap-3 text-xs">
                <span class="flex items-center gap-2 text-fg-3">
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full" style={`background: var(--${d.tone})`} />
                  {d.label}
                </span>
                <span class="figure text-xs">{d.value}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <!-- Disciplines -->
      <article class="surface rise flex min-w-0 flex-col p-8 md:p-10 lg:col-span-7" style="--step:5">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h3 class="text-[0.9375rem] font-medium text-fg">Delivery disciplines</h3>
          <span class="mono-label">{disciplines.length} tracked</span>
        </div>
        <div class="mt-8 flex flex-1 flex-col justify-center">
          <BarsH items={disciplineData} labelWidth="11rem" />
        </div>
      </article>

      <!-- Consolidation + methodology -->
      <article class="surface rise flex min-w-0 flex-col p-8 md:p-10 lg:col-span-5" style="--step:6">
        <h3 class="text-[0.9375rem] font-medium text-fg">Tools to procure</h3>
        <p class="mt-1.5 text-xs leading-relaxed text-fg-4">
          The stated basis for a 60-70% lower total cost of ownership.
        </p>
        <div class="mt-8">
          <BarsV
            items={[
              { label: 'Conventional', value: 6, muted: true },
              { label: 'Process Genesis', value: 1, tone: 'd2' },
            ]}
            max={7}
            ticks={3}
            height={150}
          />
        </div>

        <div class="mt-8 border-t border-line pt-7">
          <p class="mono-label">Methodology</p>
          <p class="mt-2.5 text-xs leading-relaxed text-fg-3">
            The 85 / 60 / 99%+ figures are reported by clients from their own deployments, not a
            benchmark we ran. We would rather say so than imply a controlled study.
          </p>
          <a
            href="/contact/"
            class="link-u mt-3 inline-block font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-primary"
          >
            Ask how each was measured →
          </a>
        </div>
      </article>
    </div>

    {/* The chip row that sat here listed the same sectors under the same
        heading as the donut panel above, which now carries them with counts.
        Two identical lists is congestion, not emphasis. */}
  </div>
</section>
