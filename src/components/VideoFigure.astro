---
/**
 * A video, presented the way the rest of the site presents things.
 *
 * Two modes.
 *
 * `autoplay` runs it muted and looping as soon as it scrolls into view, so
 * the section shows the product moving rather than a still of it. Browsers
 * only permit autoplay without sound, and this is an explainer carrying
 * narration, so the sound control is the loudest thing in the frame rather
 * than a detail in a corner. Silent, the video is wallpaper.
 *
 * Without `autoplay` it rests on a poster and builds the player on click.
 *
 * Three rules hold in both modes:
 *
 * **Nothing downloads until it is nearly on screen.** The file is 8 MB and
 * most visitors to a platform page never scroll this far. An observer arms
 * it one viewport out; the click mode fetches nothing at all until asked.
 *
 * **It can always be stopped.** Content that moves by itself for more than
 * five seconds needs a way to stop it (WCAG 2.2.2), so the pause control is
 * real, visible and keyboard reachable rather than a hover affordance.
 *
 * **Reduced motion means no motion.** With that preference set the autoplay
 * path is abandoned before a source is ever assigned, so nothing moves and
 * nothing downloads.
 */

interface Props {
  src: string;
  poster: string;
  /** Real duration, used for the badge and the structured data. */
  durationSeconds: number;
  title: string;
  /** Optional WebVTT track. Absent is stated rather than hidden. */
  captions?: string;
  /**
   * Lay the title over the poster. Off where the page prints its own
   * heading beneath, so it is neither said twice nor dropped on top of
   * whatever the film has burned into its lower strip.
   */
  showTitle?: boolean;
  /** Play muted and looping once in view, rather than waiting for a click. */
  autoplay?: boolean;
  ratio?: string;
  class?: string;
}

const {
  src,
  poster,
  durationSeconds,
  title,
  captions,
  showTitle = true,
  autoplay = false,
  ratio = '16 / 9',
  class: className = '',
} = Astro.props;

const mins = Math.floor(durationSeconds / 60);
const secs = Math.round(durationSeconds % 60);
const stamp = `${mins}:${String(secs).padStart(2, '0')}`;
---

<figure
  class:list={['vf', className]}
  data-video
  data-src={src}
  data-captions={captions}
  data-autoplay={autoplay ? 'true' : undefined}
>
  <div class="vf-frame relative overflow-hidden border border-line bg-raised" style={`aspect-ratio:${ratio}`}>
    {
      autoplay ? (
        <>
          {/* Sits underneath until the first frame paints, so the box is
              never empty and reduced-motion users keep a real image. */}
          <img
            src={poster}
            alt=""
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            class="vf-under absolute inset-0 h-full w-full object-cover"
          />

          <video
            class="vf-el absolute inset-0 h-full w-full"
            muted
            loop
            playsinline
            preload="none"
            aria-label={title}
          >
            {captions && <track kind="captions" src={captions} srclang="en" label="English" default />}
          </video>

          {/* Top, not bottom. This video carries burned-in subtitles across
              the lower strip of the frame, and a control bar there sat
              directly on the words. */}
          <div class="vf-bar absolute left-0 right-0 top-0 flex flex-wrap items-center gap-3 p-4 md:p-5">
            {/* Sound first and in the accent, because a muted explainer is
                the failure case and this is the way out of it. */}
            <button type="button" class="vf-btn vf-btn--loud" data-vf-sound aria-pressed="false">
              <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="currentColor">
                <path d="M4 9v6h4l5 4V5L8 9H4Z" />
                <path class="vf-wave" d="M15.5 8.5a4 4 0 0 1 0 7v-7Zm0-4.4a8 8 0 0 1 0 15.8v-2.06a6 6 0 0 0 0-11.68V4.1Z" />
              </svg>
              <span data-vf-sound-label>Turn on sound</span>
            </button>

            <button type="button" class="vf-btn" data-vf-pause>
              <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true" fill="currentColor">
                <path class="vf-ico-pause" d="M7 5h3.5v14H7zm6.5 0H17v14h-3.5z" />
                <path class="vf-ico-play" d="M8 5.5v13l11-6.5z" />
              </svg>
              <span data-vf-pause-label>Pause</span>
            </button>

            <span class="vf-stamp ml-auto shrink-0 font-mono text-[0.6875rem] tabular-nums">{stamp}</span>
          </div>
        </>
      ) : (
        <button type="button" class="vf-start group absolute inset-0 block w-full" data-vf-start aria-label={`Play: ${title}`}>
          <img
            src={poster}
            alt=""
            width="1280"
            height="720"
            loading="lazy"
            decoding="async"
            class="vf-poster h-full w-full object-cover"
          />
          <span class="vf-scrim absolute inset-0" aria-hidden="true" />
          <span class="vf-play absolute left-1/2 top-1/2 flex items-center justify-center rounded-full" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
              <path d="M8 5.5v13l11-6.5z" />
            </svg>
          </span>
          {/* Top, not bottom. Films subtitle themselves across the lower
              strip, and an overlay there lands on the words. */}
          <span class="vf-meta absolute left-0 right-0 top-0 flex items-start justify-between gap-4 p-5 md:p-6" aria-hidden="true">
            {showTitle ? (
              <span class="vf-title font-display text-[1.0625rem] leading-snug md:text-[1.25rem]">{title}</span>
            ) : (
              <span />
            )}
            <span class="vf-stamp shrink-0 font-mono text-[0.6875rem] tabular-nums">{stamp}</span>
          </span>
        </button>
      )
    }
  </div>

  <figcaption class="mt-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <span class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-fg-4">
      {stamp} · {autoplay ? 'loops silently until you turn the sound on' : 'plays here, nothing is sent anywhere'}
    </span>
    {
      !captions && (
        /* The film burns its subtitles into the picture, so it is not silent
           to a deaf viewer. What is still missing is a selectable track,
           which is what a screen reader, a translation and a reader who
           wants to change the type size all need. Saying "no captions"
           would have been wrong; saying nothing would have been worse. */
        <span class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-fg-4">
          Subtitles on screen · selectable track to follow
        </span>
      )
    }
  </figcaption>
</figure>

<style>
  .vf-frame { border-radius: var(--radius-lg); box-shadow: var(--depth); }

  /* ── Autoplay mode ───────────────────────────────────────────────── */
  .vf-el { object-fit: cover; background: #000; opacity: 0; transition: opacity 0.7s var(--ease-out-soft); }
  .vf-el.is-on { opacity: 1; }
  .vf-under { filter: saturate(0.95); }

  .vf-bar { background: linear-gradient(to bottom, color-mix(in oklch, var(--base) 86%, transparent), transparent); }

  .vf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: color-mix(in oklch, var(--base) 78%, transparent);
    backdrop-filter: blur(8px);
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.3s, border-color 0.3s, background-color 0.3s;
  }
  .vf-btn:hover { color: var(--fg); border-color: var(--primary); }
  .vf-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

  .vf-btn--loud { color: #15202b; background: #ffc20e; border-color: #ffc20e; }
  .vf-btn--loud:hover { color: #15202b; background: #ffcd3a; border-color: #ffcd3a; }
  /* Once sound is on it stops shouting and becomes an ordinary control. */
  .vf-btn--loud[aria-pressed='true'] {
    color: var(--fg-2);
    background: color-mix(in oklch, var(--base) 78%, transparent);
    border-color: var(--line-strong);
  }
  .vf-wave { opacity: 0; }
  .vf-btn--loud[aria-pressed='true'] .vf-wave { opacity: 1; }

  .vf-ico-play { display: none; }
  [data-vf-pause].is-paused .vf-ico-pause { display: none; }
  [data-vf-pause].is-paused .vf-ico-play { display: inline; }

  /* ── Click-to-play mode ──────────────────────────────────────────── */
  .vf-start { cursor: pointer; }
  .vf-start:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  .vf-poster { transition: transform 0.9s var(--ease-out-soft), filter 0.6s; filter: saturate(0.9); }
  .vf-start:hover .vf-poster, .vf-start:focus-visible .vf-poster { transform: scale(1.02); filter: saturate(1); }

  .vf-scrim {
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--base) 82%, transparent) 0%,
      color-mix(in oklch, var(--base) 42%, transparent) 20%,
      transparent 44%
    );
  }

  .vf-play {
    width: 5rem;
    height: 5rem;
    margin: -2.5rem 0 0 -2.5rem;
    color: #15202b;
    background: #ffc20e;
    box-shadow: 0 0 0 10px rgb(255 194 14 / 0.2), 0 14px 40px -12px rgb(0 0 0 / 0.5);
    transition: transform 0.45s var(--ease-spring), box-shadow 0.4s;
  }
  .vf-play svg { margin-left: 0.15rem; }
  .vf-start:hover .vf-play, .vf-start:focus-visible .vf-play {
    transform: scale(1.07);
    box-shadow: 0 0 0 17px rgb(255 194 14 / 0.26), 0 14px 40px -12px rgb(0 0 0 / 0.5);
  }

  .vf-title { color: var(--fg); text-shadow: 0 1px 12px color-mix(in oklch, var(--base) 70%, transparent); }
  .vf-stamp {
    color: var(--fg-2);
    border: 1px solid var(--line-strong);
    background: color-mix(in oklch, var(--base) 70%, transparent);
    backdrop-filter: blur(6px);
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
  }

  .vf-frame :global(video.vf-full) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  @media (prefers-reduced-motion: reduce) {
    .vf-poster, .vf-play, .vf-el { transition: none; }
    .vf-start:hover .vf-poster, .vf-start:hover .vf-play { transform: none; }
  }
</style>

<script>
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-video]').forEach((fig) => {
    const frame = fig.querySelector<HTMLElement>('.vf-frame');
    if (!frame) return;

    /* ── Click to play ──────────────────────────────────────────── */
    const start = fig.querySelector<HTMLButtonElement>('[data-vf-start]');
    if (start) {
      start.addEventListener(
        'click',
        () => {
          const video = document.createElement('video');
          video.className = 'vf-full';
          video.src = fig.dataset.src ?? '';
          video.controls = true;
          video.autoplay = true;
          video.playsInline = true;
          video.preload = 'auto';
          video.setAttribute('controlsList', 'nodownload');
          const vtt = fig.dataset.captions;
          if (vtt) {
            const t = document.createElement('track');
            t.kind = 'captions';
            t.src = vtt;
            t.srclang = 'en';
            t.label = 'English';
            t.default = true;
            video.appendChild(t);
          }
          frame.replaceChildren(video);
          video.focus();
          void video.play().catch(() => {});
        },
        { once: true },
      );
      return;
    }

    /* ── Autoplay, muted and looping ────────────────────────────── */
    const video = fig.querySelector<HTMLVideoElement>('.vf-el');
    const sound = fig.querySelector<HTMLButtonElement>('[data-vf-sound]');
    const soundLabel = fig.querySelector<HTMLElement>('[data-vf-sound-label]');
    const pauseBtn = fig.querySelector<HTMLButtonElement>('[data-vf-pause]');
    const pauseLabel = fig.querySelector<HTMLElement>('[data-vf-pause-label]');
    if (!video) return;

    /**
     * Reduced motion wins outright. No source is ever assigned, so nothing
     * moves and the 8 MB is never fetched; the poster underneath is what
     * remains, and controls for a video that will not play would be a lie.
     */
    if (REDUCED.matches) {
      fig.querySelector<HTMLElement>('.vf-bar')?.remove();
      return;
    }

    const setPaused = (paused: boolean) => {
      pauseBtn?.classList.toggle('is-paused', paused);
      if (pauseLabel) pauseLabel.textContent = paused ? 'Play' : 'Pause';
    };

    /**
     * Two observers with one job each, and they must not overlap.
     *
     * The first only fetches, one viewport out. The second only plays and
     * pauses, and only once the thing is actually on screen. An earlier
     * version had the fetch observer start playback too, so it began one
     * viewport early and the visibility observer, seeing something not yet
     * on screen, paused it a frame later. The video never moved.
     */
    let loaded = false;
    /** Set when the visitor pressed pause, so nothing restarts under them. */
    let heldByUser = false;

    const load = () => {
      if (loaded) return;
      loaded = true;
      video.src = fig.dataset.src ?? '';
      video.load();
    };

    const play = () => {
      load();
      void video.play().catch(() => {
        // Refused even when muted, as some battery-saving modes do. The
        // poster stays and the control becomes the way in.
        setPaused(true);
      });
    };

    video.addEventListener('playing', () => video.classList.add('is-on'), { once: true });

    const warm = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { load(); warm.disconnect(); } }),
      { rootMargin: '100% 0px' },
    );
    warm.observe(fig);

    // A looping video nobody is looking at is a drain on the battery.
    const onScreen = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) {
            if (!video.paused) video.pause();
          } else if (!heldByUser && video.paused) {
            play();
          }
        }),
      { threshold: 0.15 },
    );
    onScreen.observe(fig);

    sound?.addEventListener('click', () => {
      const turningOn = video.muted;
      video.muted = !turningOn;
      if (turningOn) {
        // Sound means they are watching rather than glancing, so hand over a
        // scrubber and stop the loop from restarting under them.
        video.controls = true;
        video.loop = false;
        setPaused(false);
        void video.play().catch(() => {});
      }
      sound.setAttribute('aria-pressed', turningOn ? 'true' : 'false');
      if (soundLabel) soundLabel.textContent = turningOn ? 'Sound on' : 'Turn on sound';
    });

    pauseBtn?.addEventListener('click', () => {
      if (video.paused) {
        heldByUser = false;
        play();
        setPaused(false);
      } else {
        heldByUser = true;
        video.pause();
        setPaused(true);
      }
    });
  });
</script>
