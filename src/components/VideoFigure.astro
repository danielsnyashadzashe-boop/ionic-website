---
/**
 * A video, presented the way the rest of the site presents things.
 *
 * Three decisions worth keeping:
 *
 * **Nothing downloads until someone asks.** The file is 8 MB. A `<video>`
 * element with a poster still fetches metadata on every page load, and on a
 * platform page most visitors never reach the video at all. So the resting
 * state is a poster image and a button; the real element is created on click,
 * which is also a user gesture, so it may autoplay with sound.
 *
 * **The frame is ours, the controls are the browser's.** A custom poster and
 * play affordance means the page looks like the page. Once playing, native
 * controls take over, because a hand-built scrubber is a worse scrubber and
 * an accessibility liability.
 *
 * **It reserves its space.** The aspect ratio is set from the real
 * dimensions, so nothing shifts when the poster or the video loads.
 */

interface Props {
  src: string;
  poster: string;
  /** Real duration, used for the badge and the structured data. */
  durationSeconds: number;
  title: string;
  /** Optional WebVTT track. Absent is stated rather than hidden. */
  captions?: string;
  ratio?: string;
  class?: string;
}

const {
  src,
  poster,
  durationSeconds,
  title,
  captions,
  ratio = '16 / 9',
  class: className = '',
} = Astro.props;

const mins = Math.floor(durationSeconds / 60);
const secs = Math.round(durationSeconds % 60);
const stamp = `${mins}:${String(secs).padStart(2, '0')}`;
---

<figure class:list={['vf', className]} data-video data-src={src} data-captions={captions}>
  <div class="vf-frame relative overflow-hidden border border-line bg-raised" style={`aspect-ratio:${ratio}`}>
    {/* The resting state. Replaced wholesale on first play. */}
    <button type="button" class="vf-start group absolute inset-0 block w-full" data-vf-start aria-label={`Play: ${title}`}>
      <img
        src={poster}
        alt=""
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
        class="vf-poster h-full w-full object-cover"
      />

      <span class="vf-scrim absolute inset-0" aria-hidden="true"></span>

      <span class="vf-play absolute left-1/2 top-1/2 flex items-center justify-center rounded-full" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
          <path d="M8 5.5v13l11-6.5z"></path>
        </svg>
      </span>

      <span class="vf-meta absolute bottom-0 left-0 right-0 flex items-end justify-between gap-4 p-5 md:p-7" aria-hidden="true">
        <span class="vf-title font-display text-[1.0625rem] leading-snug md:text-[1.25rem]">{title}</span>
        <span class="vf-stamp shrink-0 font-mono text-[0.6875rem] tabular-nums">{stamp}</span>
      </span>
    </button>
  </div>

  <figcaption class="mt-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
    <span class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-fg-4">
      {stamp} · plays here, nothing is sent anywhere
    </span>
    {
      !captions && (
        /* Said out loud rather than quietly missing. An explainer with no
           captions shuts out anyone who cannot hear it. */
        <span class="font-mono text-[0.625rem] uppercase tracking-[0.12em] text-fg-4">
          Captions to follow
        </span>
      )
    }
  </figcaption>
</figure>

<style>
  .vf-frame { border-radius: var(--radius-lg); box-shadow: var(--depth); }

  .vf-start { cursor: pointer; }
  .vf-start:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }

  .vf-poster { transition: transform 0.9s var(--ease-out-soft), filter 0.6s; filter: saturate(0.9); }
  .vf-start:hover .vf-poster,
  .vf-start:focus-visible .vf-poster { transform: scale(1.02); filter: saturate(1); }

  /* The poster is a pale illustration and the site is dark, so the frame
     needs a floor under the caption or the text sits on near-white. */
  .vf-scrim {
    background: linear-gradient(
      to top,
      color-mix(in oklch, var(--base) 90%, transparent) 0%,
      color-mix(in oklch, var(--base) 55%, transparent) 22%,
      transparent 48%
    );
  }

  .vf-play {
    width: 5rem;
    height: 5rem;
    margin: -2.5rem 0 0 -2.5rem;
    /* The brand amber at full strength, not var(--accent-warm).
       That token darkens to #7e600e on light grounds so small TEXT stays
       legible, which is right for a marker and wrong for a filled disc with
       a dark glyph on it: there the bright value is both higher contrast and
       more obviously the brand. Fixed in both themes for the same reason. */
    color: #15202b;
    background: #ffc20e;
    box-shadow:
      0 0 0 10px rgb(255 194 14 / 0.2),
      0 14px 40px -12px rgb(0 0 0 / 0.5);
    transition: transform 0.45s var(--ease-spring), box-shadow 0.4s;
  }
  .vf-play svg { margin-left: 0.15rem; }
  .vf-start:hover .vf-play,
  .vf-start:focus-visible .vf-play {
    transform: scale(1.07);
    box-shadow:
      0 0 0 17px rgb(255 194 14 / 0.26),
      0 14px 40px -12px rgb(0 0 0 / 0.5);
  }

  .vf-title { color: var(--fg); text-shadow: 0 1px 12px color-mix(in oklch, var(--base) 70%, transparent); }
  .vf-stamp {
    color: var(--fg-2);
    border: 1px solid var(--line-strong);
    background: color-mix(in oklch, var(--base) 70%, transparent);
    backdrop-filter: blur(6px);
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
  }

  /* Once playing, the native element fills the frame. */
  .vf-frame :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  @media (prefers-reduced-motion: reduce) {
    .vf-poster, .vf-play { transition: none; }
    .vf-start:hover .vf-poster { transform: none; }
    .vf-start:hover .vf-play { transform: none; }
  }
</style>

<script>
  /**
   * Swap the poster for a real player on first click.
   *
   * Built here rather than rendered with `preload="none"` because Safari
   * fetches a poster-bearing video's metadata anyway, and because creating
   * it inside the click handler keeps the user gesture, so `play()` is
   * allowed to start with sound.
   */
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((fig) => {
    const start = fig.querySelector<HTMLButtonElement>('[data-vf-start]');
    const frame = fig.querySelector<HTMLElement>('.vf-frame');
    if (!start || !frame) return;

    start.addEventListener(
      'click',
      () => {
        const video = document.createElement('video');
        video.src = fig.dataset.src ?? '';
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = 'auto';
        video.setAttribute('controlsList', 'nodownload');

        const vtt = fig.dataset.captions;
        if (vtt) {
          const track = document.createElement('track');
          track.kind = 'captions';
          track.src = vtt;
          track.srclang = 'en';
          track.label = 'English';
          track.default = true;
          video.appendChild(track);
        }

        frame.replaceChildren(video);
        video.focus();
        // A refused autoplay is not an error worth surfacing; the controls
        // are right there.
        void video.play().catch(() => {});
      },
      { once: true },
    );
  });
</script>
