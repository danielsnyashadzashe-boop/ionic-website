---
/**
 * Small animated motifs for places where a column carries a label alone.
 *
 * Built for places where a column carries a label and nothing else: the
 * services list had a number, a heading and then two hundred pixels of
 * nothing beside every entry, which reads as a layout that lost something
 * rather than as deliberate space.
 *
 * Each motif animates continuously from page load and has a resting position
 * that still reads as a diagram when motion is off. All markup is static, so
 * Astro's scoped styles reach it and nothing needs `is:global`.
 */

interface Props {
  kind:
    | 'strategy'
    | 'process'
    | 'change'
    | 'erp'
    | 'software'
    | 'ai'
    | 'run'
    | 'map'
    | 'people';
  class?: string;
}

const { kind, class: className = '' } = Astro.props;
---

<div class:list={['glyph', className]} data-glyph aria-hidden="true">
  <svg viewBox="0 0 120 120">
    {
      kind === 'strategy' && (
        /* Several routes considered, one chosen and drawn through. */
        <>
          <path class="g-ghost" d="M16 96 C44 96 44 44 60 44 C76 44 76 24 104 24" style="--n:0" />
          <path class="g-ghost" d="M16 96 C44 96 44 76 60 76 C76 76 76 96 104 96" style="--n:1" />
          <path class="g-draw" d="M16 96 C44 96 44 60 60 60 C76 60 76 36 104 36" />
          <circle class="g-dot" cx="16" cy="96" r="4.5" />
          <circle class="g-pulse" cx="104" cy="36" r="5.5" />
        </>
      )
    }

    {
      kind === 'process' && (
        /* A queue clearing: the pile at the slow station drains. */
        <>
          <line class="g-rail" x1="14" y1="60" x2="106" y2="60" />
          {[30, 60, 90].map((x) => (
            <rect class="g-station" x={x - 11} y="49" width="22" height="22" rx="5" />
          ))}
          {[0, 1, 2].map((n) => (
            <rect class="g-work" x="24" y="54" width="10" height="10" rx="2.5" style={`--n:${n}`} />
          ))}
          {[0, 1, 2].map((n) => (
            <rect class="g-queue" x={52 + n * 7} y="84" width="5" height="9" rx="1.5" style={`--n:${n}`} />
          ))}
        </>
      )
    }

    {
      kind === 'change' && (
        /* Adoption spreading outward, one person at a time. */
        <>
          <circle class="g-seed" cx="60" cy="60" r="7" />
          {[
            [60, 26],
            [92, 44],
            [92, 78],
            [60, 94],
            [28, 78],
            [28, 44],
          ].map(([x, y], n) => (
            <>
              <line class="g-spoke" x1="60" y1="60" x2={x} y2={y} style={`--n:${n}`} />
              <circle class="g-adopt" cx={x} cy={y} r="6" style={`--n:${n}`} />
            </>
          ))}
        </>
      )
    }

    {
      kind === 'erp' && (
        /* Scattered modules settling into one grid. */
        <>
          {[
            [26, 26],
            [60, 26],
            [94, 26],
            [26, 60],
            [60, 60],
            [94, 60],
            [26, 94],
            [60, 94],
          ].map(([x, y], n) => (
            <rect class="g-mod" x={x - 13} y={y - 13} width="26" height="26" rx="6" style={`--n:${n}`} />
          ))}
          <rect class="g-core" x="81" y="81" width="26" height="26" rx="6" />
        </>
      )
    }

    {
      kind === 'software' && (
        /* Two systems, and a connector drawing itself across the gap. */
        <>
          <rect class="g-box" x="12" y="40" width="34" height="40" rx="8" />
          <rect class="g-box" x="74" y="40" width="34" height="40" rx="8" />
          <path class="g-bridge" d="M46 60 H74" />
          {[0, 1].map((n) => (
            <circle class="g-packet" cx="46" cy="60" r="4" style={`--n:${n}`} />
          ))}
          <path class="g-bracket" d="M26 52 L20 60 L26 68" />
          <path class="g-bracket" d="M94 52 L100 60 L94 68" />
        </>
      )
    }

    {
      kind === 'ai' && (
        /* A scatter resolving into the line through it. */
        <>
          {[
            [22, 86],
            [36, 72],
            [48, 78],
            [60, 58],
            [72, 62],
            [86, 40],
            [98, 34],
          ].map(([x, y], n) => (
            <circle class="g-point" cx={x} cy={y} r="3.6" style={`--n:${n}`} />
          ))}
          <path class="g-trend" d="M20 88 L100 32" />
          <line class="g-axis" x1="16" y1="100" x2="104" y2="100" />
          <line class="g-axis" x1="16" y1="100" x2="16" y2="24" />
        </>
      )
    }

    {
      kind === 'run' && (
        /* A steady trace with a beat travelling along it. */
        <>
          <path
            class="g-trace"
            d="M12 60 H34 L40 42 L48 78 L56 52 L62 60 H108"
          />
          <circle class="g-beat" cx="12" cy="60" r="4.5" />
          <circle class="g-ring" cx="60" cy="60" r="30" />
        </>
      )
    }

    {
      kind === 'map' && (
        /* Lanes with the handover points between them lighting in turn. */
        <>
          {[34, 60, 86].map((y) => (
            <line class="g-lane" x1="14" y1={y} x2="106" y2={y} />
          ))}
          <path class="g-path" d="M22 34 H50 V60 H78 V86 H104" />
          {[
            [50, 34],
            [78, 60],
            [104, 86],
          ].map(([x, y], n) => (
            <circle class="g-hand" cx={x} cy={y} r="5.5" style={`--n:${n}`} />
          ))}
        </>
      )
    }

    {
      kind === 'people' && (
        /* The same thinking at every size. */
        <>
          {[40, 26, 14].map((r, n) => (
            <circle class="g-nest" cx="60" cy="60" r={r} style={`--n:${n}`} />
          ))}
          <circle class="g-core" cx="60" cy="60" r="5" />
        </>
      )
    }
  </svg>
</div>

<style>
  .glyph { width: 100%; max-width: 7.5rem; }
  .glyph.glyph-lg { max-width: 11rem; }
  .glyph.glyph-sm { max-width: 6.25rem; }
  .glyph.glyph-hero { max-width: 22rem; }
  .glyph svg { display: block; width: 100%; height: auto; overflow: visible; }

  /* One stroke vocabulary for every motif, so nine drawings read as a set. */
  [data-glyph] :is(path, line, circle, rect) {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* ── Strategy ────────────────────────────────────────────────────── */
  .g-ghost {
    stroke: var(--fg-4);
    stroke-dasharray: 3 5;
    opacity: 0.4;
    animation: g-breathe 4.4s ease-in-out infinite;
    animation-delay: calc(var(--n) * 1.1s);
  }
  @keyframes g-breathe { 0%, 100% { opacity: 0.42; } 50% { opacity: 0.9; } }
  .g-draw {
    stroke: var(--primary);
    stroke-dasharray: 150;
    animation: g-trace 4.4s ease-in-out infinite;
  }
  @keyframes g-trace {
    0% { stroke-dashoffset: 150; }
    45%, 80% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -150; }
  }
  .g-dot { fill: var(--accent-warm); stroke: none; }
  .g-pulse {
    fill: var(--accent-warm);
    stroke: none;
    animation: g-pop 4.4s ease-out infinite;
  }
  @keyframes g-pop {
    0%, 42% { opacity: 0; transform: scale(0.4); }
    55%, 86% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }

  /* ── Process ─────────────────────────────────────────────────────── */
  .g-rail { stroke: var(--fg-4); stroke-dasharray: 3 5; opacity: 0.7; }
  .g-work {
    fill: var(--primary);
    stroke: none;
    animation: g-travel 4.2s linear infinite;
    animation-delay: calc(var(--n) * 1.4s);
  }
  @keyframes g-travel {
    0% { transform: translateX(0); opacity: 0; }
    8% { opacity: 1; }
    34% { transform: translateX(30px); }
    /* The dwell at the middle station is the point of the drawing. */
    58% { transform: translateX(30px); }
    92% { transform: translateX(60px); opacity: 1; }
    100% { transform: translateX(60px); opacity: 0; }
  }
  .g-queue {
    fill: var(--accent-warm);
    stroke: none;
    animation: g-stack 4.2s ease-out infinite;
    animation-delay: calc(var(--n) * 0.46s);
  }
  @keyframes g-stack {
    0%, 28% { opacity: 0; transform: translateY(5px); }
    44%, 78% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; }
  }

  /* ── Change ──────────────────────────────────────────────────────── */
  .g-seed { stroke: var(--primary); }
  .g-spoke {
    stroke: var(--fg-4);
    stroke-dasharray: 36;
    animation: g-reach 5s ease-out infinite;
    animation-delay: calc(var(--n) * 0.44s);
  }
  @keyframes g-reach {
    0%, 6% { stroke-dashoffset: 36; }
    30%, 88% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 36; }
  }
  .g-adopt {
    animation: g-light 5s ease-out infinite;
    animation-delay: calc(var(--n) * 0.44s);
  }
  @keyframes g-light {
    0%, 24% { stroke: var(--line-strong); }
    38%, 86% { stroke: var(--accent-warm); }
    100% { stroke: var(--line-strong); }
  }

  /* ── ERP ─────────────────────────────────────────────────────────── */
  .g-mod {
    animation: g-settle 5.4s var(--ease-out-soft) infinite;
    animation-delay: calc(var(--n) * 0.14s);
  }
  @keyframes g-settle {
    0% { opacity: 0; transform: translate(6px, -6px) scale(0.86); }
    22%, 82% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }
  .g-core { stroke: var(--accent-warm); }

  /* ── Software ────────────────────────────────────────────────────── */
  .g-box { stroke: var(--line-strong); }
  .g-bridge { stroke: var(--fg-4); stroke-dasharray: 3 5; }
  .g-bracket { stroke: var(--primary); }
  .g-packet {
    fill: var(--primary);
    stroke: none;
    animation: g-hop 3s ease-in-out infinite;
    animation-delay: calc(var(--n) * 1.5s);
  }
  @keyframes g-hop {
    0% { transform: translateX(0); opacity: 0; }
    14% { opacity: 1; }
    86% { transform: translateX(28px); opacity: 1; }
    100% { transform: translateX(28px); opacity: 0; }
  }

  /* ── AI ──────────────────────────────────────────────────────────── */
  .g-axis { stroke: var(--fg-4); opacity: 0.6; }
  .g-point {
    fill: var(--primary);
    stroke: none;
    animation: g-plot 5s ease-out infinite;
    animation-delay: calc(var(--n) * 0.13s);
  }
  @keyframes g-plot {
    0% { opacity: 0; transform: translateY(5px); }
    18%, 84% { opacity: 1; transform: none; }
    100% { opacity: 0; }
  }
  .g-trend {
    stroke: var(--accent-warm);
    stroke-dasharray: 100;
    animation: g-fit 5s ease-in-out infinite;
  }
  @keyframes g-fit {
    0%, 30% { stroke-dashoffset: 100; }
    62%, 86% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 100; }
  }

  /* ── Run ─────────────────────────────────────────────────────────── */
  .g-ring { stroke: var(--line); opacity: 0.6; }
  .g-trace { stroke: var(--line-strong); }
  .g-beat {
    fill: var(--accent-warm);
    stroke: none;
    animation: g-along 3.4s linear infinite;
  }
  @keyframes g-along {
    0% { transform: translateX(0); opacity: 0; }
    8% { opacity: 1; }
    92% { transform: translateX(96px); opacity: 1; }
    100% { transform: translateX(96px); opacity: 0; }
  }

  /* ── Map ─────────────────────────────────────────────────────────── */
  .g-lane { stroke: var(--line); opacity: 0.7; }
  .g-path { stroke: var(--primary); }
  .g-hand {
    animation: g-light 4.2s ease-out infinite;
    animation-delay: calc(var(--n) * 0.7s);
  }

  /* ── People ──────────────────────────────────────────────────────── */
  .g-nest {
    animation: g-breathe 4.8s ease-in-out infinite;
    animation-delay: calc(var(--n) * 0.5s);
  }

  /* Everything still reads as a diagram when motion is off, which is why
     each element above has a sensible resting position. */
  @media (prefers-reduced-motion: reduce) {
    [data-glyph] * { animation: none !important; }
    .g-draw, .g-trend, .g-spoke { stroke-dashoffset: 0 !important; }
    .g-pulse { opacity: 1 !important; }
  }
</style>
