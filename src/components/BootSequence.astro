---
/**
 * Launch sequence.
 *
 * The reference (anime.js) doesn't open with spectacle — it opens with
 * precision: a lot of small elements resolving into order on a tight,
 * staggered clock. That is the idea borrowed here, not the visuals.
 *
 * Rules it holds to:
 *   - once per session, never on repeat navigation
 *   - ~1.5s, and skippable by any key, click or scroll
 *   - the page underneath is already rendered and interactive; this is an
 *     overlay, so a slow device or a JS failure costs nothing
 *   - fully skipped under prefers-reduced-motion
 */

const cells = Array.from({ length: 48 }, (_, i) => i);

const log = [
  'orchestrator · online',
  'agents · 12/14 active',
  'regions · 5 synced',
  'pipeline · nominal',
];
---

<div id="boot" class="fixed inset-0 z-[200] hidden" aria-hidden="true">
  <div class="boot-veil absolute inset-0 bg-base"></div>

  <div class="blueprint absolute inset-0 opacity-60"></div>

  <div class="relative flex h-full w-full items-center justify-center">
    <div class="w-full max-w-md px-6">
      <!-- Resolving cell matrix -->
      <div class="grid grid-cols-12 gap-[3px]">
        {cells.map((i) => <span class="boot-cell h-[3px] w-full bg-fg" style={`--i:${i}`} />)}
      </div>

      <!-- Readout -->
      <div class="mt-6 flex items-baseline justify-between">
        <span class="mono-label boot-fade" style="--i:6">Ionic · orchestration</span>
        <span class="figure text-xs text-primary"><span id="boot-pct">0</span>%</span>
      </div>

      <!-- Segmented progress -->
      <div class="mt-3 h-px w-full origin-left bg-line-strong">
        <div id="boot-bar" class="h-px w-full origin-left scale-x-0 bg-primary"></div>
      </div>

      <!-- Boot log -->
      <ul class="mt-5 space-y-1.5">
        {
          log.map((line, i) => (
            <li class="boot-line flex items-center gap-2 font-mono text-[0.6875rem] text-fg-4" style={`--i:${i}`}>
              <span class="text-primary">›</span>
              {line}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  #boot.running { display: block; }

  /* Cells resolve in a pseudo-random order rather than a sweep — a sweep
     reads as a loading bar, a scatter reads as a system coming up. */
  .boot-cell {
    opacity: 0.08;
    transform: scaleY(0.4);
    transform-origin: bottom;
  }
  #boot.running .boot-cell {
    animation: cell-set 0.42s var(--ease-spring) both;
    animation-delay: calc((var(--i) * 37 % 48) * 11ms);
  }

  @keyframes cell-set {
    0% { opacity: 0.08; transform: scaleY(0.4); }
    60% { opacity: 1; transform: scaleY(1); }
    100% { opacity: 0.22; transform: scaleY(1); }
  }

  #boot.running .boot-fade { animation: veil 0.4s var(--ease-out-soft) 0.45s both; }

  #boot.running .boot-line {
    animation: slide-x 0.34s var(--ease-out-soft) both;
    animation-delay: calc(0.55s + var(--i) * 90ms);
  }

  #boot.running #boot-bar {
    animation: draw-x 1.05s var(--ease-mech) 0.35s both;
  }

  /* The veil lifts upward, handing off to the page. */
  #boot.closing .boot-veil,
  #boot.closing .blueprint {
    transition: transform 0.62s var(--ease-mech), opacity 0.4s linear 0.2s;
    transform: translateY(-100%);
    opacity: 0;
  }
  #boot.closing > .relative {
    transition: opacity 0.25s linear, transform 0.5s var(--ease-mech);
    opacity: 0;
    transform: translateY(-1.5rem);
  }
</style>

<script>
  const KEY = 'ionic-booted';

  const run = () => {
    const boot = document.getElementById('boot');
    if (!boot) return;

    // Reduced motion, repeat visit, or a non-root entry: skip entirely.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (location.pathname !== '/') return;
    try {
      if (sessionStorage.getItem(KEY) === '1') return;
      sessionStorage.setItem(KEY, '1');
    } catch {
      return; // storage blocked — do not risk showing it on every page
    }

    boot.classList.add('running');
    document.body.style.overflow = 'hidden';

    const pct = document.getElementById('boot-pct');
    const start = performance.now();
    const DUR = 1400;

    let raf = 0;
    const tick = (now: number) => {
      const t = Math.min((now - start) / DUR, 1);
      // Match the bar's easing so the number and the bar agree.
      const eased = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      if (pct) pct.textContent = String(Math.round(eased * 100));
      if (t < 1) raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      cancelAnimationFrame(raf);
      if (pct) pct.textContent = '100';
      boot.classList.add('closing');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        boot.classList.remove('running', 'closing');
        boot.remove();
      }, 700);
    };

    const timer = window.setTimeout(finish, DUR + 120);
    const skip = () => { window.clearTimeout(timer); finish(); };

    window.addEventListener('keydown', skip, { once: true });
    window.addEventListener('pointerdown', skip, { once: true });
    window.addEventListener('wheel', skip, { once: true, passive: true });
  };

  run();
</script>
