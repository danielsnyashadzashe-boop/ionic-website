---
import { Image } from 'astro:assets';
import { photos, type PhotoKey } from '@/data/photos';

/**
 * Captioned photograph.
 *
 * Runs through `astro:assets`, so the build emits responsive AVIF/WebP from
 * the 2560px master and the browser picks a size from `sizes`. Nothing here
 * ships a multi-megabyte original.
 *
 * The frame is treated as a surface like any other panel, with the same border,
 * radius and lit edge, so a photograph sits in the design rather than being
 * pasted on top of it. A tint scrim keeps stock photography from fighting the
 * palette, and every caption carries an "Illustrative" marker because these
 * are not photographs of Ionic staff or client sites.
 */

interface Props {
  photo: PhotoKey;
  /** Rendered width hint for srcset selection. */
  sizes?: string;
  /** Aspect ratio of the frame. Portrait sources get a portrait default. */
  ratio?: string;
  /** Show the caption. Off for purely decorative placements. */
  showCaption?: boolean;
  /** Load eagerly. Use only for an above-the-fold image. */
  eager?: boolean;
  /** Gentle rise-and-settle, as the model site does with its imagery. */
  float?: boolean;
  class?: string;
}

const {
  photo,
  sizes = '(min-width: 1024px) 40rem, 100vw',
  ratio,
  showCaption = true,
  eager = false,
  float = false,
  class: className = '',
} = Astro.props;

const p = photos[photo];
const isPortrait = p.src.height > p.src.width;
/**
 * Our own artwork, as opposed to stock photography.
 *
 * Read with `in` rather than `p.brand`, because the registry is a literal
 * object and only the entries that set the flag carry the property at all.
 */
const isBrand = 'brand' in p && p.brand === true;

/**
 * Brand artwork keeps its own shape unless told otherwise. A key visual
 * carries text close to its edges, and the 16/10 photographic crop would
 * take a slice off the top and bottom, which on this one is the strapline.
 */
const nativeRatio = `${p.src.width} / ${p.src.height}`;
const frameRatio = ratio ?? (isBrand ? nativeRatio : isPortrait ? '3 / 4' : '16 / 10');

/**
 * The traced outline is an SVG polygon rather than a border, because a
 * clipped element cannot paint a border along the edges the clip removed.
 * Drawing it in the frame's own aspect ratio keeps the notch square-ish
 * instead of sheared, and `vector-effect` keeps the stroke a constant
 * hairline whatever the rendered size.
 */
/**
 * Notch geometry, derived from the frame's ratio and handed to both the CSS
 * clip and the SVG so the two paths cannot drift apart.
 *
 * Both axes are sized off the WIDTH. Sizing the vertical off the height
 * instead made the notch a different shape on every ratio: a 21/9 banner got
 * a shallow sliver and a 3/4 portrait got a deep bite, and neither read as
 * the same device. Anchoring to width keeps the cut a constant 2.4:1
 * whatever the frame.
 */
const NOTCH_W = 0.13;
const NOTCH_ASPECT = 0.42;

const [rw, rh] = frameRatio.split('/').map((n) => Number(n.trim()) || 1);
const VW = rw * 100;
const VH = rh * 100;
const nx = VW * NOTCH_W;
const ny = nx * NOTCH_ASPECT;
/** Same two lengths as percentages, for the clip-path. */
const nxPct = NOTCH_W * 100;
const nyPct = (ny / VH) * 100;
const outline = [
  [0, 0],
  [VW - nx, 0],
  [VW - nx, ny],
  [VW, ny],
  [VW, VH],
  [nx, VH],
  [nx, VH - ny],
  [0, VH - ny],
]
  .map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`)
  .join(' ');

/**
 * Placed by hand, not generated. Four squares at irregular intervals with
 * mismatched sizes and two treatments; a loop with even spacing is the
 * version that looks machine-made.
 *
 * All four keep clear of the top-right and bottom-left corners, because that
 * is where the notch is cut. A square sitting in the cut read as a rendering
 * glitch rather than decoration.
 */
const specks = [
  { class: 'speck speck-warm', style: 'width:.7rem;height:.7rem;top:-.35rem;left:17%;animation-delay:-1.2s' },
  { class: 'speck speck-ring', style: 'width:.9rem;height:.9rem;bottom:-.35rem;right:24%;animation-delay:-5.1s' },
  { class: 'speck speck-mute', style: 'width:.35rem;height:.35rem;top:38%;right:-.2rem;animation-delay:-3.4s' },
];
---

<figure class={`group ${className}`}>
  {/* Positioning context for the outline and squares, and the query container
      the decoration sizes itself against. It has to be the frame alone, not
      the whole figure, or they stretch across the caption too. */}
  <div
    class:list={['notch-frame relative', float && 'floating']}
    style={`aspect-ratio: ${frameRatio}`}
  >
  <div
    class:list={['notch surface absolute inset-0 overflow-hidden', isBrand && 'plate']}
    style={`--nx: ${nxPct}%; --ny: ${nyPct.toFixed(3)}%`}
  >
    <Image
      src={p.src}
      alt={p.alt}
      sizes={sizes}
      widths={[480, 800, 1200, 1800]}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class:list={[
        'h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]',
        isBrand ? 'group-hover:scale-[1.012]' : 'group-hover:scale-[1.03]',
      ]}
    />

    {/* A single specular pass, as light crosses something lacquered. Only on
        brand plates: on a photograph it reads as a lens flare someone left
        in, but on a flat dark card it is the thing that makes it feel like
        an object rather than a rectangle of colour. */}
    {isBrand && <span class="sheen pointer-events-none absolute inset-0" aria-hidden="true" />}

    {/* Scrim: sinks stock photography toward the palette so it does not sit
        on the page as a bright rectangle. */}
    {/* The scrim stops borrowed photography fighting the palette. Artwork
        we drew ourselves is already in the palette, so multiplying it by
        the ground only dulls it. */}
    {!isBrand && (
      <span class="pointer-events-none absolute inset-0 bg-base/35 mix-blend-multiply" aria-hidden="true" />
    )}
    <span
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-base/70 via-transparent to-transparent"
      aria-hidden="true"></span>
  </div>

  {/* Outline and squares sit outside the clipped frame, so they are siblings
      of it rather than children. Anything inside would be cut away. */}
  <svg
    class="notch-line"
    viewBox={`0 0 ${VW} ${VH}`}
    preserveAspectRatio="none"
    fill="none"
    aria-hidden="true"
  >
    <polygon
      points={outline}
      stroke="currentColor"
      stroke-width="1.5"
      vector-effect="non-scaling-stroke"
    />
  </svg>

  {specks.map((s) => <span class={s.class} style={s.style} aria-hidden="true" />)}
  </div>

  {
    showCaption && (
      <figcaption class="mt-3 flex items-start gap-3">
        <span class="mt-[3px] h-3 w-px shrink-0 bg-primary" aria-hidden="true" />
        <span class="min-w-0">
          <span class="block text-[0.8125rem] leading-relaxed text-fg-3">{p.caption}</span>
          {p.illustrative && (
            <span class="mt-1 block font-mono text-[0.5625rem] uppercase tracking-[0.12em] text-fg-4">
              Illustrative
            </span>
          )}
        </span>
      </figcaption>
    )
  }
</figure>

<style>
  /* ── Brand plate ──────────────────────────────────────────────────
     A title card is flat, dark and nearly all ground, so it needs its own
     light rather than borrowing the page's. The sheen is a single pass
     across the diagonal, slow enough to read as a reflection rather than
     as a loading shimmer, and it runs only on hover or keyboard focus so
     nothing on the page moves by itself. */
  .plate .sheen {
    background: linear-gradient(
      100deg,
      transparent 38%,
      color-mix(in oklch, #ffffff 9%, transparent) 47%,
      color-mix(in oklch, #ffc20e 11%, transparent) 52%,
      transparent 62%
    );
    transform: translateX(-120%);
    opacity: 0;
    transition: transform 1.15s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.45s;
  }
  .group:hover .plate .sheen,
  .group:focus-within .plate .sheen {
    transform: translateX(120%);
    opacity: 1;
  }

  /* The edge warms with it, so the hover is felt at the frame as well as
     across the face. */
  .plate {
    transition: box-shadow 0.6s var(--ease-out-soft), border-color 0.6s var(--ease-out-soft);
  }
  .group:hover .plate,
  .group:focus-within .plate {
    border-color: color-mix(in oklch, #ffc20e 38%, var(--line));
    box-shadow:
      0 0 0 1px color-mix(in oklch, #ffc20e 16%, transparent),
      0 26px 60px -28px rgb(0 0 0 / 0.65);
  }

  @media (prefers-reduced-motion: reduce) {
    .plate .sheen { display: none; }
    .plate { transition: none; }
  }
</style>
