---
/**
 * Radial gauge, drawn at build time.
 *
 * Everything here is known when the site builds, so there is no reason for a
 * browser to download a charting library, measure a container and then draw
 * it. Static SVG renders instantly, works with JS disabled, and cannot end up
 * blank because hydration was slow.
 */
interface Props {
  value: number;
  display: string;
  label: string;
  tone: string;
  size?: number;
}

const { value, display, label, tone, size = 156 } = Astro.props;

const R = 62;
const C = 2 * Math.PI * R;
const dash = (Math.min(Math.max(value, 0), 100) / 100) * C;
---

<figure class="flex flex-col items-center">
  <svg
    viewBox="0 0 160 160"
    width={size}
    height={size}
    role="img"
    aria-label={`${label}: ${display}`}
    class="max-w-full"
  >
    <circle cx="80" cy="80" r={R} fill="none" stroke="var(--panel)" stroke-width="13" />
    <circle
      class="gauge-arc"
      cx="80"
      cy="80"
      r={R}
      fill="none"
      stroke={`var(--${tone})`}
      stroke-width="13"
      stroke-linecap="butt"
      stroke-dasharray={`${dash} ${C}`}
      transform="rotate(-90 80 80)"
      style={`--dash:${dash}; --circ:${C}`}
    />
    <text
      x="80"
      y="80"
      text-anchor="middle"
      dominant-baseline="central"
      fill="var(--fg)"
      style="font-family: var(--font-mono); font-size: 25px; font-weight: 500; letter-spacing: -1px"
    >
      {display}
    </text>
  </svg>

  <figcaption class="mt-1 text-center font-mono text-[0.625rem] uppercase tracking-[0.1em] text-fg-4">
    {label}
  </figcaption>
</figure>

<style>
  .gauge-arc {
    stroke-dasharray: 0 var(--circ);
    animation: gauge 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes gauge {
    to { stroke-dasharray: var(--dash) var(--circ); }
  }
  @supports (animation-timeline: view()) {
    .gauge-arc { animation-timeline: view(); animation-range: entry 0% entry 55%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gauge-arc { animation: none; stroke-dasharray: var(--dash) var(--circ); }
  }
</style>
