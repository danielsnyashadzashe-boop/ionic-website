---
/**
 * Cumulative trend line with an area fill, drawn at build time.
 * The path is computed here rather than measured in a browser, so it renders
 * identically with or without JavaScript.
 */
interface Point {
  label: string;
  value: number;
}

interface Props {
  points: Point[];
  height?: number;
  tone?: string;
}

const { points, height = 176, tone = 'd2' } = Astro.props;

const W = 300;
const H = 120;
const PAD = { l: 22, r: 8, t: 10, b: 8 };
const top = Math.max(...points.map((p) => p.value));
const ticks = 3;
const gridVals = Array.from({ length: ticks + 1 }, (_, i) => Math.round((top / ticks) * i));

const px = (i: number) =>
  PAD.l + (i / Math.max(points.length - 1, 1)) * (W - PAD.l - PAD.r);
const py = (v: number) => PAD.t + (1 - v / top) * (H - PAD.t - PAD.b);

const coords = points.map((p, i) => ({ x: px(i), y: py(p.value), ...p }));
const line = coords.map((c, i) => `${i === 0 ? 'M' : 'L'} ${c.x.toFixed(1)} ${c.y.toFixed(1)}`).join(' ');
const area = `${line} L ${coords.at(-1)!.x.toFixed(1)} ${H - PAD.b} L ${coords[0].x.toFixed(1)} ${H - PAD.b} Z`;
const uid = `trend-${Math.random().toString(36).slice(2, 8)}`;
---

<div style={`height:${height}px`}>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="none"
    class="h-[calc(100%-1.25rem)] w-full"
    role="img"
    aria-label={`Cumulative: ${points.map((p) => `${p.label} ${p.value}`).join(', ')}`}
  >
    <defs>
      <linearGradient id={uid} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color={`var(--${tone})`} stop-opacity="0.38" />
        <stop offset="100%" stop-color={`var(--${tone})`} stop-opacity="0.02" />
      </linearGradient>
    </defs>

    {
      gridVals.map((v) => (
        <>
          <line x1={PAD.l} y1={py(v)} x2={W - PAD.r} y2={py(v)} stroke="var(--line)" stroke-width="0.8" />
          <text
            x={PAD.l - 5}
            y={py(v)}
            text-anchor="end"
            dominant-baseline="central"
            fill="var(--fg-4)"
            style="font-family: var(--font-mono); font-size: 7px"
          >
            {v}
          </text>
        </>
      ))
    }

    <path class="trend-area" d={area} fill={`url(#${uid})`} />
    <path class="trend-line" d={line} fill="none" stroke={`var(--${tone})`} stroke-width="1.6" vector-effect="non-scaling-stroke" />

    {
      coords.map((c, i) => (
        <circle class="trend-dot" cx={c.x} cy={c.y} r="2.6" fill={`var(--${tone})`} style={`--i:${i}`}>
          <title>{`${c.label}: ${c.value}`}</title>
        </circle>
      ))
    }
  </svg>

  <div class="flex justify-between pl-[7%] pr-[3%]">
    {
      points.map((p) => (
        <span class="font-mono text-[0.5625rem] uppercase tracking-[0.05em] text-fg-4">{p.label}</span>
      ))
    }
  </div>
</div>

<style>
  .trend-line {
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    animation: dash 1.1s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .trend-area { animation: veil 0.9s 0.3s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .trend-dot { animation: veil 0.4s both; animation-delay: calc(0.35s + var(--i) * 120ms); }

  @supports (animation-timeline: view()) {
    .trend-line, .trend-area, .trend-dot {
      animation-timeline: view();
      animation-range: entry 0% entry 55%;
      animation-delay: 0s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .trend-line { animation: none; stroke-dashoffset: 0; }
    .trend-area, .trend-dot { animation: none; }
  }
</style>
