---
import BaseLayout from './BaseLayout.astro';
import TelemetryBar from '@/components/TelemetryBar.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CommandPalette from '@/components/CommandPalette.astro';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  hreflang?: boolean;
}

const { title, description, schema, noindex, hreflang } = Astro.props;
---

<BaseLayout {title} {description} {schema} {noindex} {hreflang}>
  <TelemetryBar />
  <Header />
  <main id="main" class="relative z-10">
    <slot />
  </main>
  <Footer />
  <CommandPalette />
</BaseLayout>
